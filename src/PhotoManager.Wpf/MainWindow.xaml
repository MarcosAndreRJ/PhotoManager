<Window x:Class="PhotoManager.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PhotoManager.Wpf.Views"
        Title="PhotoManager" Icon="/PhotoManager;component/Assets/PhotoManager.ico" Width="1366" Height="768" MinWidth="1100" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}"
        UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate DataType="{x:Type views:LibraryViewModel}"><views:LibraryView /></DataTemplate>
        <DataTemplate DataType="{x:Type views:MetadataEditorViewModel}"><views:MetadataView /></DataTemplate>
        <DataTemplate DataType="{x:Type views:MicrostockViewModel}"><views:MicrostockView /></DataTemplate>
        <DataTemplate DataType="{x:Type views:TransferViewModel}"><views:TransferView /></DataTemplate>
        <DataTemplate DataType="{x:Type views:ToolsViewModel}"><views:ToolsView /></DataTemplate>
        <DataTemplate DataType="{x:Type views:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>
    <DockPanel>
        <!-- Barra superior: marca + abas das áreas principais -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource NavBarBrush}" Height="52" Visibility="{Binding ShowNavigation, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" Margin="18,0,12,0" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="&#xE722;" Style="{StaticResource IconText}" FontSize="17" Foreground="White" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="PhotoManager" FontSize="17" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,0,28,0" />
                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton AutomationProperties.Name="{Binding Label}" Style="{StaticResource NavTabButton}" GroupName="MainNavigation" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource IconText}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <ContentControl Content="{Binding CurrentView}" />
    </DockPanel>
</Window>
