<UserControl x:Class="PhotoManager.Wpf.Controls.VideoPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" Background="#0B1220">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <MediaElement x:Name="Media" Grid.Row="0" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" ScrubbingEnabled="True"
                      MediaOpened="Media_MediaOpened" MediaEnded="Media_MediaEnded" MediaFailed="Media_MediaFailed" MouseLeftButtonUp="Media_Click" />

        <TextBlock x:Name="ErrorText" Grid.Row="0" Visibility="Collapsed" Foreground="#C6D0E0" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" />

        <Border Grid.Row="1" Background="#CC0B1220" Padding="12,8">
            <DockPanel LastChildFill="True">
                <Button x:Name="PlayButton" DockPanel.Dock="Left" Style="{StaticResource DarkToolButton}" Click="PlayButton_Click" ToolTip="Reproduzir / pausar (Espaço)" Width="38" Height="34">
                    <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                </Button>
                <Button x:Name="MuteButton" DockPanel.Dock="Right" Style="{StaticResource DarkToolButton}" Click="MuteButton_Click" ToolTip="Sem som" Width="38" Height="34" Margin="6,0,0,0">
                    <TextBlock x:Name="MuteGlyph" Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                </Button>
                <Slider x:Name="VolumeSlider" DockPanel.Dock="Right" Width="80" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" ToolTip="Volume" />
                <TextBlock x:Name="DurationText" DockPanel.Dock="Right" Text="0:00" Foreground="#C6D0E0" FontSize="12" VerticalAlignment="Center" Margin="10,0,12,0" />
                <TextBlock x:Name="PositionText" DockPanel.Dock="Left" Text="0:00" Foreground="#C6D0E0" FontSize="12" VerticalAlignment="Center" Margin="10,0,10,0" />
                <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" VerticalAlignment="Center" IsMoveToPointEnabled="True" IsEnabled="False"
                        PreviewMouseLeftButtonDown="Seek_MouseDown" PreviewMouseLeftButtonUp="Seek_MouseUp" ValueChanged="Seek_ValueChanged" ToolTip="Posição" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
