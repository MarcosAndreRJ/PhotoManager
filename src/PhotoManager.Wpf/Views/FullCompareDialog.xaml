<Window x:Class="PhotoManager.Wpf.Views.FullCompareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="980" Height="680" MinWidth="750" MinHeight="450"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <!-- Estilo de badge para o status do item -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#2563EB" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Same">
                    <Setter Property="Background" Value="#16A34A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Different">
                    <Setter Property="Background" Value="#EA580C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Comparação completa (recursiva até o último nível)" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Esquerda:" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FolderLeft}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderLeft}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Direita:" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FolderRight}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderRight}" />
                </Grid>
            </StackPanel>

            <Button Grid.Column="1" Command="{Binding RefreshCommand}" VerticalAlignment="Top" Padding="10,6" Margin="10,0,0,0" ToolTip="Recarregar comparação">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Atualizar" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Barra de resumo de status -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Total: " Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text=" itens" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Border Background="#16A34A" CornerRadius="3" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Iguais: " Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding SameCount}" FontWeight="Bold" Foreground="#16A34A" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Border Background="#EA580C" CornerRadius="3" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Diferentes: " Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding DifferentCount}" FontWeight="Bold" Foreground="#EA580C" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Border Background="#2563EB" CornerRadius="3" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Só à esquerda: " Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding OnlyLeftCount}" FontWeight="Bold" Foreground="#2563EB" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Background="#2563EB" CornerRadius="3" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Só à direita: " Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding OnlyRightCount}" FontWeight="Bold" Foreground="#2563EB" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Barra de Filtros e Busca -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="Todos" IsChecked="{Binding IsFilterAll}" GroupName="CompareFilter" Margin="0,0,12,0" />
                <RadioButton Content="Só diferenças" IsChecked="{Binding IsFilterDiff}" GroupName="CompareFilter" Margin="0,0,12,0" FontWeight="SemiBold" />
                <RadioButton Content="Iguais" IsChecked="{Binding IsFilterSame}" GroupName="CompareFilter" Margin="0,0,12,0" />
                <RadioButton Content="Só à esquerda" IsChecked="{Binding IsFilterOnlyLeft}" GroupName="CompareFilter" Margin="0,0,12,0" />
                <RadioButton Content="Só à direita" IsChecked="{Binding IsFilterOnlyRight}" GroupName="CompareFilter" Margin="0,0,12,0" />
            </StackPanel>

            <Grid Grid.Column="1" HorizontalAlignment="Right" Width="260">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="26,5,8,5" VerticalAlignment="Center" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
                <TextBlock Text="Filtrar por nome/caminho…" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- Lista de Itens -->
        <Grid Grid.Row="3">
            <ListView ItemsSource="{Binding FilteredItems}" BorderBrush="{DynamicResource BorderBrush}"
                      ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Estado" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadgeStyle}">
                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Item / Caminho Relativo" Width="320">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding RelativePath}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" ToolTip="{Binding RelativePath}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Painel Esquerdo" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LeftDetails}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Painel Direito" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RightDetails}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Detalhes" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Details}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Indicador de Carregamento -->
            <Border Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="8" Margin="0,0,0,10" />
                    <TextBlock Text="Comparando itens recursivamente até o último nível…" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Rodapé -->
        <DockPanel Grid.Row="4" LastChildFill="False" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding FilteredCountText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />

            <Button Content="Fechar" IsCancel="True" DockPanel.Dock="Right" Width="100" Margin="10,0,0,0" />
            <Button Content="Copiar lista" Command="{Binding CopyListCommand}" DockPanel.Dock="Right" Width="120" ToolTip="Copia o resumo e todos os itens filtrados para a Área de Transferência" />
        </DockPanel>
    </Grid>
</Window>
