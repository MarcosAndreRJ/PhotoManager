<Window x:Class="PhotoManager.Wpf.Views.MissingItemsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Itens não encontrados" Width="720" Height="540" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource WindowBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Itens não encontrados" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
            <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"
                       Text="Remover tira estes itens do catálogo, junto com tags, coleções, notas e histórico de metadados deles. Nenhum arquivo é excluído (eles já não existem)." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Remover" Command="{Binding RemoveCommand}" Padding="12,5" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Remove este item do catálogo" />
                                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="Medium" Foreground="{DynamicResource HeadingBrush}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" IsDefault="True" Width="90" Margin="10,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Remover todos" Command="{Binding RemoveAllCommand}" Style="{StaticResource AccentButton}" Padding="14,6" />
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
        </DockPanel>
    </Grid>
</Window>
