<UserControl x:Class="PhotoManager.Wpf.Views.MetadataView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PhotoManager.Wpf.Views">
    <UserControl.Resources>
        <Style x:Key="OpBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="128" /><Setter Property="SelectedValuePath" Value="Operation" />
            <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="EditBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Padding" Value="8,5" /></Style>
        <!-- Campos alterados ficam com fundo azul claro -->
        <Style x:Key="TitleBox" TargetType="TextBox" BasedOn="{StaticResource EditBox}"><Style.Triggers><DataTrigger Binding="{Binding TitleChanged}" Value="True"><Setter Property="Background" Value="{DynamicResource SoftAccentBrush}" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="DescriptionBox" TargetType="TextBox" BasedOn="{StaticResource EditBox}"><Style.Triggers><DataTrigger Binding="{Binding DescriptionChanged}" Value="True"><Setter Property="Background" Value="{DynamicResource SoftAccentBrush}" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="AuthorBox" TargetType="TextBox" BasedOn="{StaticResource EditBox}"><Style.Triggers><DataTrigger Binding="{Binding AuthorChanged}" Value="True"><Setter Property="Background" Value="{DynamicResource SoftAccentBrush}" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="CopyrightBox" TargetType="TextBox" BasedOn="{StaticResource EditBox}"><Style.Triggers><DataTrigger Binding="{Binding CopyrightChanged}" Value="True"><Setter Property="Background" Value="{DynamicResource SoftAccentBrush}" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="MiniLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
        <Style x:Key="CounterText" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
        <Style x:Key="FieldTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style x:Key="ExifLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Margin" Value="0,0,0,2" /><Setter Property="FontSize" Value="11" /></Style>

        <!-- Contêiner da linha: borda azul na foto em foco -->
        <Style x:Key="EditorRowContainer" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <EventSetter Event="Loaded" Handler="Row_Loaded" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="10" Padding="12" Margin="0,0,10,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="KeywordChipTemplate">
            <Border Background="{DynamicResource SoftAccentBrush}" CornerRadius="12" Padding="10,2,4,2" Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentBrush}" FontSize="12" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Padding="4,2" Margin="2,0,0,0" ToolTip="Remover" Foreground="{DynamicResource AccentBrush}"
                            Command="{Binding DataContext.RemoveKeywordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                        <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="9" />
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Uma foto: miniatura, status e os campos editáveis -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type views:MetadataRowViewModel}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <CheckBox Style="{StaticResource CardCheckBox}" IsChecked="{Binding IsIncluded}" HorizontalAlignment="Left" Margin="0,0,0,6" ToolTip="Marcada = recebe as operações globais do painel à direita" />
                    <Border Width="144" Height="108" Background="#0F172A" CornerRadius="6" ClipToBounds="True" Cursor="Hand" ToolTip="Clique duas vezes para ampliar" MouseLeftButtonDown="RowThumb_MouseDown">
                        <Grid>
                            <Image Source="{Binding ThumbnailUri}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="2">
                                <Image.LayoutTransform><RotateTransform Angle="{Binding Card.UserRotation}" /></Image.LayoutTransform>
                            </Image>
                            <Border Visibility="{Binding Card.IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}" Width="30" Height="30" CornerRadius="15" Background="#99000000" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Reverter" Command="{Binding RevertCommand}" Padding="8,3" FontSize="12" Margin="0,0,6,0" Visibility="{Binding IsChanged, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Desfaz as alterações desta foto (não grava nada)" />
                            <Button Content="Salvar" Command="{Binding DataContext.SaveRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource AccentButton}" Padding="10,3" FontSize="12"
                                    Visibility="{Binding IsChanged, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Grava só esta foto" />
                        </StackPanel>
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="260" />
                        <Border Style="{StaticResource StatusBadge}" Margin="8,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding FormatText}" FontSize="10" Foreground="White" /></Border>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="changed"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="error"><Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="ok"><Setter Property="Foreground" Value="#15803D" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>

                    <StackPanel Grid.Row="1" IsEnabled="{Binding CanEdit}">
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding TitleCounter}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CounterText}"><Style.Triggers><DataTrigger Binding="{Binding TitleOver}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="Título" Style="{StaticResource MiniLabel}" /></DockPanel>
                        <TextBox Style="{StaticResource TitleBox}" Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" IsEnabled="{Binding CanEdit}">
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding DescriptionCounter}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CounterText}"><Style.Triggers><DataTrigger Binding="{Binding DescriptionOver}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="Descrição" Style="{StaticResource MiniLabel}" /></DockPanel>
                        <TextBox Style="{StaticResource DescriptionBox}" Text="{Binding DescriptionText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="52" MaxHeight="90" VerticalContentAlignment="Top" Margin="0,2,0,6" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" IsEnabled="{Binding CanEdit}">
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding KeywordCounter}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CounterText}"><Style.Triggers><DataTrigger Binding="{Binding KeywordsOver}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="Palavras-chave" Style="{StaticResource MiniLabel}" /></DockPanel>
                        <Border CornerRadius="6" Padding="6,6,6,0" Margin="0,2,0,6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Style.Triggers><DataTrigger Binding="{Binding KeywordsChanged}" Value="True"><Setter Property="Background" Value="{DynamicResource SoftAccentBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <WrapPanel>
                                <ItemsControl ItemsSource="{Binding Keywords}" ItemTemplate="{StaticResource KeywordChipTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBox Width="150" Height="26" Padding="6,2" Margin="0,0,0,6" Text="{Binding NewKeyword, UpdateSourceTrigger=PropertyChanged}" ToolTip="Digite e pressione Enter (vírgula separa várias)">
                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddKeywordCommand}" /></TextBox.InputBindings>
                                </TextBox>
                            </WrapPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="4" IsEnabled="{Binding CanEdit}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Autor" Style="{StaticResource MiniLabel}" /><TextBox Style="{StaticResource AuthorBox}" Text="{Binding AuthorText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Copyright" Style="{StaticResource MiniLabel}" /><TextBox Style="{StaticResource CopyrightBox}" Text="{Binding CopyrightText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" /></StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}">
                <Button Content="Marcar todas" Command="{Binding IncludeAllCommand}" Margin="0,0,8,0" ToolTip="Inclui todas as fotos nas operações globais" />
                <Button Content="Desmarcar todas" Command="{Binding IncludeNoneCommand}" ToolTip="Tira todas as fotos das operações globais" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Editor de metadados" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Conteúdo: lista de fotos + painel de operações -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="400" /></Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <ListBox x:Name="RowsList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Focused, Mode=TwoWay}" ItemTemplate="{StaticResource RowTemplate}" ItemContainerStyle="{StaticResource EditorRowContainer}"
                         Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" IsEnabled="{Binding IsIdle}" GotKeyboardFocus="Rows_GotKeyboardFocus" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="30">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasRows}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" FontSize="40" Foreground="{DynamicResource StarOffBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nenhuma foto para editar" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,2" HorizontalAlignment="Center" />
                    <TextBlock Text="Na Biblioteca, marque uma ou mais fotos (caixas nas miniaturas) e abra o editor pela aba Metadados." Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="4,0,0,0">
                <StackPanel IsEnabled="{Binding IsIdle}">
                    <!-- Operações globais -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Aplicar às fotos marcadas" Style="{StaticResource FieldTitle}" FontSize="14" />
                            <TextBlock Text="Cada campo tem a sua operação. “Manter” não altera. O resultado aparece nas linhas ao lado; só “Salvar” grava nos arquivos." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,10" />

                            <DockPanel><ComboBox DockPanel.Dock="Right" Style="{StaticResource OpBox}" ItemsSource="{Binding TitleOperations}" SelectedValue="{Binding TitleOperation}" /><TextBlock Text="Título" Style="{StaticResource FieldTitle}" /></DockPanel>
                            <TextBox Style="{StaticResource EditBox}" Margin="0,5,0,10" Text="{Binding GlobalTitle, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding TitleEnabled}" />

                            <DockPanel><ComboBox DockPanel.Dock="Right" Style="{StaticResource OpBox}" ItemsSource="{Binding DescriptionOperations}" SelectedValue="{Binding DescriptionOperation}" /><TextBlock Text="Descrição" Style="{StaticResource FieldTitle}" /></DockPanel>
                            <TextBox Style="{StaticResource EditBox}" Margin="0,5,0,10" Text="{Binding GlobalDescription, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DescriptionEnabled}" AcceptsReturn="True" MinHeight="52" VerticalContentAlignment="Top" />

                            <DockPanel><ComboBox DockPanel.Dock="Right" Style="{StaticResource OpBox}" ItemsSource="{Binding KeywordOperations}" SelectedValue="{Binding KeywordsOperation}" /><TextBlock Text="Palavras-chave" Style="{StaticResource FieldTitle}" /></DockPanel>
                            <StackPanel IsEnabled="{Binding KeywordsEnabled}" Margin="0,5,0,10">
                                <ItemsControl ItemsSource="{Binding Keywords}" ItemTemplate="{StaticResource KeywordChipTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding AddKeywordCommand}" Margin="6,0,0,0" Padding="10,6" ToolTip="Adicionar"><TextBlock Text="&#xE710;" Style="{StaticResource IconText}" /></Button>
                                    <TextBox Text="{Binding NewKeyword, UpdateSourceTrigger=PropertyChanged}" ToolTip="Digite e pressione Enter (vírgula separa várias)"><TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddKeywordCommand}" /></TextBox.InputBindings></TextBox>
                                </DockPanel>
                            </StackPanel>

                            <DockPanel><ComboBox DockPanel.Dock="Right" Style="{StaticResource OpBox}" ItemsSource="{Binding AuthorOperations}" SelectedValue="{Binding AuthorOperation}" /><TextBlock Text="Autor" Style="{StaticResource FieldTitle}" /></DockPanel>
                            <TextBox Style="{StaticResource EditBox}" Margin="0,5,0,10" Text="{Binding GlobalAuthor, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AuthorEnabled}" />

                            <DockPanel><ComboBox DockPanel.Dock="Right" Style="{StaticResource OpBox}" ItemsSource="{Binding CopyrightOperations}" SelectedValue="{Binding CopyrightOperation}" /><TextBlock Text="Copyright" Style="{StaticResource FieldTitle}" /></DockPanel>
                            <TextBox Style="{StaticResource EditBox}" Margin="0,5,0,10" Text="{Binding GlobalCopyright, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CopyrightEnabled}" />

                            <Border Background="{DynamicResource WindowBackground}" CornerRadius="8" Padding="10"><TextBlock Text="{Binding GlobalImpactText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}" /></Border>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button Command="{Binding ApplyGlobalCommand}" Style="{StaticResource AccentButton}" Padding="12,9"><TextBlock Text="Aplicar às marcadas" /></Button>
                                <Button Grid.Column="2" Command="{Binding ClearFormCommand}" Padding="12,9" ToolTip="Volta todas as operações para “Manter”"><TextBlock Text="Limpar" /></Button>
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Command="{Binding CopyFromFocusedCommand}" Margin="0,0,6,6" Padding="10,5" FontSize="12" ToolTip="Copia título, descrição, palavras-chave, autor e copyright da foto em foco para as outras marcadas"><TextBlock Text="Copiar da foto em foco" /></Button>
                                <Button Command="{Binding DedupeKeywordsCommand}" Margin="0,0,6,6" Padding="10,5" FontSize="12" ToolTip="Remove palavras-chave repetidas nas fotos marcadas"><TextBlock Text="Eliminar palavras repetidas" /></Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Presets -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Presets" Style="{StaticResource FieldTitle}" FontSize="14" />
                            <TextBlock Text="Guardam as operações e valores acima (ex.: Autor + Copyright + palavras a adicionar)." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Excluir" Command="{Binding DeletePresetCommand}" Style="{StaticResource DangerButton}" Margin="6,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="Carregar" Command="{Binding LoadPresetCommand}" Margin="6,0,0,0" />
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="Salvar preset" Command="{Binding SavePresetCommand}" Margin="6,0,0,0" />
                                <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome do preset" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Foto em foco -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12" Visibility="{Binding HasFocused, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Foto em foco" Style="{StaticResource FieldTitle}" FontSize="14" />
                            <TextBlock Text="{Binding Focused.FileName}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,8" />
                            <Border x:Name="FocusedThumb" Height="230" Background="#0F172A" CornerRadius="8" ClipToBounds="True" Cursor="Hand" ToolTip="Clique duas vezes para ampliar" MouseLeftButtonDown="FocusedThumb_MouseDown">
                                <Grid>
                                    <Image Source="{Binding Focused.ThumbnailUri}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="4">
                                        <Image.LayoutTransform><RotateTransform Angle="{Binding Focused.Card.UserRotation}" /></Image.LayoutTransform>
                                    </Image>
                                    <Border Visibility="{Binding Focused.Card.IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}" Width="54" Height="54" CornerRadius="27" Background="#99000000" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0" />
                                    </Border>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="8,4" FontSize="12" Click="MaximizeThumb_Click" ToolTip="Abrir em tamanho grande (foto com zoom ou vídeo com reprodutor)">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE740;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="Ampliar" /></StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock Text="CÂMERA E LENTE" Style="{StaticResource ExifLabel}" Margin="0,10,0,2" /><TextBlock Text="{Binding FocusedCamera}" TextWrapping="Wrap" />
                            <TextBlock Text="EXPOSIÇÃO" Style="{StaticResource ExifLabel}" Margin="0,8,0,2" /><TextBlock Text="{Binding FocusedExposure}" TextWrapping="Wrap" />
                            <TextBlock Text="DATA DA FOTO" Style="{StaticResource ExifLabel}" Margin="0,8,0,2" /><TextBlock Text="{Binding FocusedDate}" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="Abrir no mapa" Click="OpenMap_Click" Padding="8,3" FontSize="12" Visibility="{Binding FocusedMapUrl, Converter={x:Static views:TextToVisibilityConverter.Instance}}" />
                                <StackPanel><TextBlock Text="GPS" Style="{StaticResource ExifLabel}" /><TextBlock Text="{Binding FocusedGps}" /></StackPanel>
                            </DockPanel>
                            <TextBlock Text="HISTÓRICO DE VERSÕES" Style="{StaticResource ExifLabel}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding FocusedHistory}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,6"><TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="12" /><TextBlock Text="{Binding Details}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Text="Nenhuma edição registrada." Foreground="{DynamicResource MutedBrush}" FontSize="11" Visibility="{Binding FocusedHistory.Count, Converter={x:Static views:CountToCollapsedConverter.Instance}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Barra inferior -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding SaveAllCommand}" Style="{StaticResource AccentButton}" Padding="18,9" Margin="8,0,0,0" ToolTip="Grava só as fotos alteradas (JPEG): IPTC e XMP; o EXIF e a imagem não mudam"><TextBlock Text="{Binding SaveButtonText}" /></Button>
                <Button DockPanel.Dock="Right" Command="{Binding RevertAllCommand}" Padding="14,9" Margin="8,0,0,0" ToolTip="Descarta todos os rascunhos (não grava nada)"><TextBlock Text="Reverter tudo" /></Button>
                <Button DockPanel.Dock="Right" Command="{Binding CancelCommand}" Padding="14,9" Margin="8,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Cancelar" /></Button>
                <StackPanel VerticalAlignment="Center">
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,0,0,4" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Style.Triggers><DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
