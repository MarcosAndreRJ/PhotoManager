<UserControl x:Class="PhotoManager.Wpf.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PhotoManager.Wpf.Controls"
             xmlns:views="clr-namespace:PhotoManager.Wpf.Views"
             Focusable="True" PreviewKeyDown="Review_PreviewKeyDown" IsVisibleChanged="Review_IsVisibleChanged">
    <UserControl.Resources>
        <!-- Some quando a tela cheia está ativa (painel e filmstrip) -->
        <Style x:Key="HideInFullScreen" TargetType="FrameworkElement">
            <Style.Triggers><DataTrigger Binding="{Binding Library.IsFullScreen}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ReviewHeart" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" /><Setter Property="FontSize" Value="16" /><Setter Property="Text" Value="&#xEB51;" /><Setter Property="Foreground" Value="White" />
            <Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Text" Value="&#xEB52;" /><Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
        <Style x:Key="FieldCaption" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}"><Setter Property="Margin" Value="0,0,0,2" /></Style>
    </UserControl.Resources>

    <Grid Background="#0B1220">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ============ Coluna principal: barra de ferramentas · visualizador · filmstrip ============ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <!-- Barra de ferramentas -->
            <Border Grid.Row="0" Background="#111A2B" Padding="10,6">
                <DockPanel LastChildFill="True">
                    <Button AutomationProperties.Name="Voltar à grade" DockPanel.Dock="Left" Style="{StaticResource DarkToolButton}" Command="{Binding Library.ExitReviewCommand}" ToolTip="Voltar à grade (Esc)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72B;" Style="{StaticResource IconText}" Margin="0,0,6,0" /><TextBlock Text="Voltar" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource DarkToolButton}" Click="ZoomOut_Click" ToolTip="Diminuir zoom (−)"><TextBlock Text="&#xE71F;" Style="{StaticResource IconText}" /></Button>
                        <TextBlock Text="{Binding ZoomPercent, ElementName=Viewer, StringFormat={}{0:0}%}" Foreground="White" FontSize="12" Width="42" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource DarkToolButton}" Click="ZoomIn_Click" ToolTip="Aumentar zoom (+)"><TextBlock Text="&#xE8A3;" Style="{StaticResource IconText}" /></Button>
                        <Button Style="{StaticResource DarkToolButton}" Click="Fit_Click" ToolTip="Ajustar à janela (F)"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9A6;" Style="{StaticResource IconText}" Margin="0,0,5,0" /><TextBlock Text="Ajustar" FontSize="12" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Style="{StaticResource DarkToolButton}" Click="Actual_Click" ToolTip="Tamanho real, 100 % (1)"><TextBlock Text="100%" FontSize="12" VerticalAlignment="Center" /></Button>
                        <Button Style="{StaticResource DarkToolButton}" Command="{Binding Library.ToggleFullScreenCommand}" ToolTip="Tela cheia (Enter) — Esc sai"><TextBlock Text="&#xE740;" Style="{StaticResource IconText}" /></Button>
                        <Button Style="{StaticResource DarkToolButton}" Command="{Binding Library.RotateLeftCommand}" CommandParameter="{Binding Library.SelectedPhoto}" ToolTip="Girar à esquerda (só a exibição; o arquivo não muda)"><TextBlock Text="&#xE7A7;" Style="{StaticResource IconText}" /></Button>
                        <Button Style="{StaticResource DarkToolButton}" Command="{Binding Library.RotateRightCommand}" CommandParameter="{Binding Library.SelectedPhoto}" ToolTip="Girar à direita (só a exibição; o arquivo não muda)"><TextBlock Text="&#xE7AD;" Style="{StaticResource IconText}" /></Button>
                        <Rectangle Width="1" Fill="#33FFFFFF" Margin="6,4" />
                        <ItemsControl ItemsSource="{Binding Library.SelectionColorChoices}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding Command}" Width="18" Height="18" Margin="3,0" Padding="0" Cursor="Hand" ToolTip="{Binding Name}">
                                        <Button.Template><ControlTemplate TargetType="Button"><Ellipse Width="16" Height="16" Fill="{Binding Brush}" Stroke="#B3FFFFFF" StrokeThickness="1" /></ControlTemplate></Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Rectangle Width="1" Fill="#33FFFFFF" Margin="6,4" />
                        <Button Style="{StaticResource DarkToolButton}" Command="{Binding Library.ToggleFavoriteCommand}" CommandParameter="{Binding Library.SelectedPhoto}" ToolTip="Favorita">
                            <TextBlock DataContext="{Binding Library.SelectedPhoto}" Style="{StaticResource ReviewHeart}" />
                        </Button>
                        <controls:RatingControl Value="{Binding Rating, Mode=TwoWay}" StarSize="16" VerticalAlignment="Center" Margin="6,0,6,0" ToolTip="Avaliação (grava na hora; clique de novo para limpar)" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="6,0,0,0">
                        <Button Style="{StaticResource DarkToolButton}" Command="{Binding Library.PreviousCommand}" ToolTip="Foto anterior (←)"><TextBlock Text="&#xE76B;" Style="{StaticResource IconText}" /></Button>
                        <Button Style="{StaticResource DarkToolButton}" Command="{Binding Library.NextCommand}" ToolTip="Próxima foto (→)"><TextBlock Text="&#xE76C;" Style="{StaticResource IconText}" /></Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Library.SelectedPhoto.FileName}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260" VerticalAlignment="Center" ToolTip="{Binding Library.SelectedPhoto.FileName}" />
                        <Border Style="{StaticResource StatusBadge}" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Library.PositionText}" Foreground="White" FontSize="12" /></Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Visualizador -->
            <Grid Grid.Row="1">
                <controls:ZoomViewer x:Name="Viewer" Source="{Binding DisplayImage}" Background="#0B1220">
                    <controls:ZoomViewer.Style><Style TargetType="controls:ZoomViewer"><Style.Triggers><DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></controls:ZoomViewer.Style>
                </controls:ZoomViewer>
                <controls:VideoPlayer x:Name="Player" RotationDegrees="{Binding VideoRotation}" SourcePath="{Binding VideoPath}" Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <!-- Triagem e trecho em marcação (P/X/U · I/O/M) -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" IsHitTestVisible="False" Visibility="{Binding Library.HasPro, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border CornerRadius="6" Padding="10,4" Margin="0,0,0,6" Background="#E616A34A" Visibility="{Binding Library.SelectedPhoto.IsPicked, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="✓ Escolhida" Foreground="White" FontWeight="SemiBold" /></Border>
                    <Border CornerRadius="6" Padding="10,4" Margin="0,0,0,6" Background="#E6DC2626" Visibility="{Binding Library.SelectedPhoto.IsRejected, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="✕ Rejeitada" Foreground="White" FontWeight="SemiBold" /></Border>
                    <Border CornerRadius="6" Padding="10,4" Background="#B3000000" Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Library.MarkerRangeText}" Foreground="White" FontSize="12" />
                            <TextBlock Text="I entrada · O saída · M guarda o trecho · P/X/U triagem" Foreground="#C6D0E0" FontSize="10" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Button Style="{StaticResource DarkToolButton}" Command="{Binding Library.PreviousCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0" Background="#66000000" ToolTip="Foto anterior (←)">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Disc" Width="44" Height="44" CornerRadius="22" Background="#73000000"><TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Background" Value="#A6000000" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.25" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                </Button>
                <Button Style="{StaticResource DarkToolButton}" Command="{Binding Library.NextCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0" ToolTip="Próxima foto (→)">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Disc" Width="44" Height="44" CornerRadius="22" Background="#73000000"><TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Background" Value="#A6000000" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.25" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                </Button>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Style="{StaticResource StatusBadge}" Visibility="{Binding Library.SelectedPhoto, Converter={x:Static views:NullToCollapsedConverter.Instance}}">
                    <TextBlock Foreground="White" FontSize="12">
                        <TextBlock.Text><MultiBinding StringFormat="{}{0}  ·  {1}  ·  {2}"><Binding Path="Library.SelectedPhoto.Dimensions" /><Binding Path="Library.SelectedPhoto.SizeText" /><Binding Path="Library.SelectedPhoto.StatusText" /></MultiBinding></TextBlock.Text>
                    </TextBlock>
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" Style="{StaticResource StatusBadge}">
                    <TextBlock FontSize="11" Foreground="#C6D0E0">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Prévia reduzida…" /><Style.Triggers><DataTrigger Binding="{Binding IsFullResolution}" Value="True"><Setter Property="Text" Value="Resolução completa" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Border>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasPhoto}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="Nenhuma foto" FontSize="16" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" />
                    <TextBlock Text="Use “Voltar” para escolher uma foto na grade." Foreground="#94A3B8" HorizontalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Arquivo ausente" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Library.SelectedPhoto.IsMissing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Filmstrip virtualizado (as miniaturas vêm do cache existente) -->
            <Border Grid.Row="2" Background="#111A2B" Padding="10,8,10,6" Style="{StaticResource HideInFullScreen}">
                <ListBox x:Name="Filmstrip" ItemsSource="{Binding Library.Photos}" SelectedItem="{Binding Library.SelectedPhoto, Mode=TwoWay}" Height="104" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource FilmstripItem}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" SelectionChanged="Filmstrip_SelectionChanged">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="104" Height="68" CornerRadius="4" ClipToBounds="True" ToolTip="{Binding FileName}">
                                <Grid>
                                    <Image Source="{Binding ThumbnailUri}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality" />
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#99000000" Padding="4,1" CornerRadius="0,4,0,0"><TextBlock Text="{Binding FileName}" Foreground="White" FontSize="9" MaxWidth="96" TextTrimming="CharacterEllipsis" /></Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- ============ Painel lateral ============ -->
        <Border Grid.Column="1" Width="380" Background="{DynamicResource SurfaceBrush}" Style="{StaticResource HideInFullScreen}">
            <Grid Margin="16,14,16,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Library.SelectedPhoto.FileName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0" Text="{Binding Library.SelectedPhoto.Category, StringFormat=Categoria: {0}}" Visibility="{Binding Library.SelectedPhoto.Category, Converter={x:Static views:TextToVisibilityConverter.Instance}}" />
                </StackPanel>

                <TabControl Grid.Row="1" Style="{StaticResource UnderlineTabControl}">
                    <!-- Aba: Informações -->
                    <TabItem Header="Informações">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,12" DataContext="{Binding Library.SelectedPhoto}">
                                <TextBlock Text="ARQUIVO" Style="{StaticResource FieldCaption}" />
                                <TextBlock Text="{Binding FolderPath}" Style="{StaticResource FieldValue}" FontSize="12" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.Resources><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,6" /></Style></Grid.Resources>
                                    <TextBlock Text="Tamanho" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding SizeText}" />
                                    <TextBlock Grid.Row="1" Text="Dimensões" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Dimensions}" />
                                    <TextBlock Grid.Row="2" Text="Tipo" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusText}" />
                                    <TextBlock Grid.Row="3" Text="Criado em" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CreatedText}" />
                                    <TextBlock Grid.Row="4" Text="Modificado" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ModifiedText}" />
                                    <TextBlock Grid.Row="5" Text="Orientação" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding OrientationText}" />
                                </Grid>
                                <TextBlock Text="TAGS" Style="{StaticResource FieldCaption}" />
                                <TextBlock Text="{Binding TagsText, Converter={x:Static views:EmptyToDashConverter.Instance}}" Style="{StaticResource FieldValue}" />
                                <TextBlock Text="COLEÇÕES" Style="{StaticResource FieldCaption}" />
                                <TextBlock Text="{Binding CollectionsText, Converter={x:Static views:EmptyToDashConverter.Instance}}" Style="{StaticResource FieldValue}" />
                                <TextBlock Text="NOTA PESSOAL" Style="{StaticResource FieldCaption}" />
                                <TextBlock Text="{Binding PersonalNote, Converter={x:Static views:EmptyToDashConverter.Instance}}" Style="{StaticResource FieldValue}" />
                                <TextBlock Text="Organização (categoria, tags, coleções, nota) é editada na grade, aba Organização." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Aba: Metadados (somente leitura) -->
                    <TabItem Header="Metadados">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,12">
                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsLoadingDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Border Padding="12" CornerRadius="8" Background="{DynamicResource WarningBackgroundBrush}" Margin="0,0,0,10" Visibility="{Binding MetadataError, Converter={x:Static views:TextToVisibilityConverter.Instance}}">
                                    <TextBlock Text="{Binding MetadataError}" TextWrapping="Wrap" Foreground="#9A3412" />
                                </Border>
                                <StackPanel Visibility="{Binding HasMetadata, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SourcesText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap" />
                                    <TextBlock Text="TÍTULO" Style="{StaticResource FieldCaption}" /><TextBlock Text="{Binding TitleText}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Text="DESCRIÇÃO" Style="{StaticResource FieldCaption}" /><TextBlock Text="{Binding DescriptionText}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Text="PALAVRAS-CHAVE" Style="{StaticResource FieldCaption}" />
                                    <ItemsControl ItemsSource="{Binding Keywords}" Margin="0,0,0,4">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SoftAccentBrush}" CornerRadius="12" Padding="10,2" Margin="0,0,6,6"><TextBlock Text="{Binding}" Foreground="{DynamicResource AccentBrush}" FontSize="12" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="—" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" Visibility="{Binding Keywords.Count, Converter={x:Static views:CountToCollapsedConverter.Instance}}" />
                                    <TextBlock Text="AUTOR" Style="{StaticResource FieldCaption}" /><TextBlock Text="{Binding AuthorText}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Text="COPYRIGHT" Style="{StaticResource FieldCaption}" /><TextBlock Text="{Binding CopyrightText}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Text="CÂMERA E LENTE" Style="{StaticResource FieldCaption}" /><TextBlock Text="{Binding CameraText}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Text="EXPOSIÇÃO" Style="{StaticResource FieldCaption}" /><TextBlock Text="{Binding ExposureText}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Text="DATA DA FOTO" Style="{StaticResource FieldCaption}" /><TextBlock Text="{Binding DateTakenText}" Style="{StaticResource FieldValue}" />
                                </StackPanel>
                                <Button Command="{Binding OpenMetadataCommand}" Style="{StaticResource AccentButton}" Margin="0,6,0,0" Padding="12,9"><TextBlock Text="Editar na tela Metadados" /></Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Aba: Microstock (somente leitura) -->
                    <TabItem Header="Microstock">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,12">
                                <TextBlock Text="{Binding MicrostockNote}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Border CornerRadius="8" Padding="12" Background="{DynamicResource WindowBackground}" Visibility="{Binding HasMicrostock, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="STATUS" Style="{StaticResource FieldCaption}" />
                                        <TextBlock Text="{Binding MicrostockStatusText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="PENDÊNCIAS" Style="{StaticResource FieldCaption}" Margin="0,14,0,4" />
                                <ItemsControl ItemsSource="{Binding MicrostockIssues}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title, StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource TextBrush}" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nenhuma pendência no perfil ativo." Foreground="{DynamicResource MutedBrush}" FontSize="12" Visibility="{Binding MicrostockIssues.Count, Converter={x:Static views:CountToCollapsedConverter.Instance}}" />
                                <TextBlock Text="ENVIOS POR BANCO" Style="{StaticResource FieldCaption}" Margin="0,14,0,4" />
                                <ItemsControl ItemsSource="{Binding UploadStatuses}">
                                    <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding Details}" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding Title}" /></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nenhum envio registrado." Foreground="{DynamicResource MutedBrush}" FontSize="12" Visibility="{Binding UploadStatuses.Count, Converter={x:Static views:CountToCollapsedConverter.Instance}}" />
                                <Button Command="{Binding OpenMicrostockCommand}" Margin="0,14,0,0" Padding="12,9"><TextBlock Text="Abrir Central de Produção" /></Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Aba: Histórico -->
                    <TabItem Header="Histórico">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,12">
                                <TextBlock Text="VERSÕES DOS METADADOS" Style="{StaticResource FieldCaption}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding MetadataHistory}">
                                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Title}" FontWeight="Medium" /><TextBlock Text="{Binding Details}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nenhuma edição de metadados registrada." Foreground="{DynamicResource MutedBrush}" FontSize="12" Visibility="{Binding MetadataHistory.Count, Converter={x:Static views:CountToCollapsedConverter.Instance}}" />
                                <TextBlock Text="ENVIOS" Style="{StaticResource FieldCaption}" Margin="0,16,0,4" />
                                <ItemsControl ItemsSource="{Binding UploadHistory}">
                                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" /><TextBlock Text="{Binding Details}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nenhum envio registrado." Foreground="{DynamicResource MutedBrush}" FontSize="12" Visibility="{Binding UploadHistory.Count, Converter={x:Static views:CountToCollapsedConverter.Instance}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
