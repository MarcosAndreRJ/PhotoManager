<UserControl x:Class="PhotoManager.Wpf.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PhotoManager.Wpf.Controls"
             xmlns:views="clr-namespace:PhotoManager.Wpf.Views">
    <UserControl.Resources>
        <ContextMenu x:Key="PhotoContextMenu">
            <MenuItem Header="Exibir no Explorer" Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Text="&#xE8DA;" FontFamily="{StaticResource IconFont}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Cor" ItemsSource="{Binding PlacementTarget.Tag.ColorChoices, RelativeSource={RelativeSource AncestorType=ContextMenu}}" ToolTip="Etiqueta de cor para triagem rápida (atalho: teclas 1 a 6; 0 remove)">
                <MenuItem.Icon><TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="12" /></MenuItem.Icon>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Command" Value="{Binding Command}" />
                        <Setter Property="InputGestureText" Value="{Binding Shortcut}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
                <MenuItem.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="{Binding Brush}" Stroke="#99888888" StrokeThickness="1" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </MenuItem.ItemTemplate>
            </MenuItem>
            <Separator />
            <MenuItem Header="Girar à esquerda" Command="{Binding PlacementTarget.Tag.RotateLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" ToolTip="Gira só a exibição (miniatura, preview e player). O arquivo não é alterado.">
                <MenuItem.Icon><TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Girar à direita" Command="{Binding PlacementTarget.Tag.RotateRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" ToolTip="Gira só a exibição (miniatura, preview e player). O arquivo não é alterado.">
                <MenuItem.Icon><TextBlock Text="&#xE7AD;" FontFamily="{StaticResource IconFont}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Obter localização (GPS)" Command="{Binding PlacementTarget.Tag.FindLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" ToolTip="Lê o GPS gravado nos arquivos e descobre o nome do lugar (OpenStreetMap, com sua autorização)." />
            <Separator />
            <MenuItem Header="Excluir (Lixeira)…" Command="{Binding PlacementTarget.Tag.RecycleFromMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" InputGestureText="Del">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource FavoriteBrush}" /></MenuItem.Icon>
                <MenuItem.Style><Style TargetType="MenuItem"><Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Remover do catálogo…" Command="{Binding PlacementTarget.Tag.RemoveFromCatalogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" ToolTip="O arquivo não existe mais: tira o item do catálogo (tags, coleções e histórico dele são apagados)">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource FavoriteBrush}" /></MenuItem.Icon>
                <MenuItem.Style><Style TargetType="MenuItem"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></MenuItem.Style>
            </MenuItem>
        </ContextMenu>
        <Style x:Key="HeartGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" /><Setter Property="FontSize" Value="13" /><Setter Property="Text" Value="&#xEB51;" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Text" Value="&#xEB52;" /><Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SidebarHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}"><Setter Property="Margin" Value="10,16,0,4" /></Style>
        <!-- Botão "Revisar" e contador sobre o preview: sobem para o topo quando o preview é um vídeo (embaixo fica a barra do player) -->
        <Style x:Key="PreviewOverlayButton" TargetType="Button" BasedOn="{StaticResource DarkToolButton}">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Style.Triggers><DataTrigger Binding="{Binding IsSelectedVideo}" Value="True"><Setter Property="VerticalAlignment" Value="Top" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="PreviewOverlayBadge" TargetType="Border" BasedOn="{StaticResource StatusBadge}">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Style.Triggers><DataTrigger Binding="{Binding IsSelectedVideo}" Value="True"><Setter Property="VerticalAlignment" Value="Top" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Padding" Value="12,8" /></Style>
        <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Frame" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SoftAccentBrush}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Item da barra lateral: ícone, nome e contagem -->
        <DataTemplate x:Key="SidebarEntryTemplate" DataType="{x:Type views:SidebarEntry}">
            <StackPanel>
                <Button ToolTip="{Binding ToolTipText}"
                        Command="{Binding DataContext.SelectSidebarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource SoftAccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Style="{StaticResource IconText}" Width="24" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowCount, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,4,8,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSeparatorAfter}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Selos do item: triagem, Shorts, pilha, cortes, uso, desfocada (os mesmos na grade uniforme e na justificada) -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="5,1" /><Setter Property="Margin" Value="0,0,3,0" /><Setter Property="Background" Value="{DynamicResource ScrimBrush}" />
        </Style>
        <Style x:Key="PillText" TargetType="TextBlock"><Setter Property="Foreground" Value="White" /><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <DataTemplate x:Key="CardPills" DataType="{x:Type views:PhotoCardViewModel}">
            <StackPanel Orientation="Horizontal" IsHitTestVisible="True">
                <Border Style="{StaticResource Pill}" Background="#E616A34A" ToolTip="Escolhida (P)" Visibility="{Binding IsPicked, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Style="{StaticResource PillText}" /></Border>
                <Border Style="{StaticResource Pill}" Background="#E6DC2626" ToolTip="Rejeitada (X)" Visibility="{Binding IsRejected, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" Style="{StaticResource PillText}" /></Border>
                <Border Style="{StaticResource Pill}" Background="#E6DB2777" ToolTip="Vertical 9:16 até 3 min: pronto para Shorts / Reels" Visibility="{Binding IsShortForm, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="SHORTS" Style="{StaticResource PillText}" /></Border>
                <Button Style="{x:Null}" Cursor="Hand" ToolTip="{Binding StackToolTip}" Command="{Binding DataContext.ToggleStackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                        Visibility="{Binding IsStackTop, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.Template><ControlTemplate TargetType="Button"><Border Style="{StaticResource Pill}" Background="#E62563EB"><TextBlock Text="{Binding StackText}" Style="{StaticResource PillText}" /></Border></ControlTemplate></Button.Template>
                </Button>
                <Border Style="{StaticResource Pill}" ToolTip="Tem trechos marcados (entrada/saída)" Visibility="{Binding HasMarkers, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xE8C6;" FontFamily="{StaticResource IconFont}" Style="{StaticResource PillText}" /></Border>
                <Border Style="{StaticResource Pill}" Background="#E60D9488" ToolTip="{Binding UsageText}" Visibility="{Binding HasUsage, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xE8FB;" FontFamily="{StaticResource IconFont}" Style="{StaticResource PillText}" /></Border>
                <Border Style="{StaticResource Pill}" Background="#E6B45309" ToolTip="Pouca nitidez: provavelmente tremida ou desfocada" Visibility="{Binding IsBlurry, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" Style="{StaticResource PillText}" /></Border>
            </StackPanel>
        </DataTemplate>

        <!-- Grade justificada: a imagem ocupa o bloco inteiro (proporção real); informações aparecem sobre ela -->
        <DataTemplate x:Key="JustifiedTileTemplate" DataType="{x:Type views:PhotoCardViewModel}">
            <Grid x:Name="Tile" ClipToBounds="True" Background="{DynamicResource PlaceholderBrush}" ContextMenuOpening="PhotoCard_ContextMenuOpening" ContextMenu="{StaticResource PhotoContextMenu}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  controls:HoverVideoPreview.Source="{Binding VideoPreviewPath}" controls:HoverVideoPreview.Rotation="{Binding VideoRotation}"
                  controls:HoverVideoPreview.IsEnabled="{Binding DataContext.HoverPreview, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="{Binding FileName}">
                <Image Source="{Binding ThumbnailUri}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality">
                    <Image.LayoutTransform><RotateTransform Angle="{Binding UserRotation}" /></Image.LayoutTransform>
                </Image>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                    <CheckBox Style="{StaticResource CardCheckBox}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" Margin="0,0,4,0"
                              Visibility="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardPills}" />
                </StackPanel>
                <Border Style="{StaticResource StatusBadge}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding DurationText, StringFormat=▶ {0}}" FontSize="10" Foreground="White" /></Border>
                <!-- Faixa inferior com título e estrelas: aparece ao passar o mouse, quando selecionada ou quando há estrelas -->
                <Border x:Name="Info" VerticalAlignment="Bottom" Padding="8,18,60,6" IsHitTestVisible="False" Opacity="0">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0" /><GradientStop Color="#B3000000" Offset="1" /></LinearGradientBrush></Border.Background>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <controls:RatingControl Value="{Binding Rating, Mode=OneWay}" IsReadOnly="True" StarSize="10" HorizontalAlignment="Left" Visibility="{Binding HasRating, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
                <Button x:Name="Heart" Style="{StaticResource FavoriteToggleButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" ToolTip="Favorita" Opacity="0"
                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <TextBlock Style="{StaticResource HeartGlyph}" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True"><Setter TargetName="Info" Property="Opacity" Value="1" /><Setter TargetName="Heart" Property="Opacity" Value="1" /></Trigger>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter TargetName="Heart" Property="Opacity" Value="1" /></DataTrigger>
                <DataTrigger Binding="{Binding HasRating}" Value="True"><Setter TargetName="Info" Property="Opacity" Value="1" /></DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter TargetName="Tile" Property="Opacity" Value="0.5" /></DataTrigger>
                <DataTrigger Binding="{Binding IsRejected}" Value="True"><Setter TargetName="Tile" Property="Opacity" Value="0.55" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Container da grade justificada: seleção = borda de destaque; etiqueta de cor = faixa colorida embaixo -->
        <Style x:Key="JustifiedContainer" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <ContentPresenter />
                            <Border x:Name="ColorBar" Height="4" VerticalAlignment="Bottom" Background="{Binding ColorBrush}" Visibility="{Binding HasColor, Converter={StaticResource BooleanToVisibilityConverter}}" IsHitTestVisible="False" />
                            <Border x:Name="Frame" BorderThickness="0" BorderBrush="{DynamicResource PhotoCardSelectedBorder}" IsHitTestVisible="False" />
                            <Border x:Name="Check" Visibility="Collapsed" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource PhotoCardSelectedBorder}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7,0,0,9" IsHitTestVisible="False">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="BorderThickness" Value="4" /><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cartão de miniatura -->
        <DataTemplate x:Key="PhotoCardTemplate" DataType="{x:Type views:PhotoCardViewModel}">
            <Grid Width="184" Background="Transparent" ContextMenuOpening="PhotoCard_ContextMenuOpening" ContextMenu="{StaticResource PhotoContextMenu}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Opacity" Value="0.55" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Height="124" Background="{DynamicResource PlaceholderBrush}">
                    <Grid>
                        <Image Source="{Binding ThumbnailUri}" RenderOptions.BitmapScalingMode="LowQuality">
                            <Image.Style><Style TargetType="Image"><Setter Property="Stretch" Value="UniformToFill" /><Style.Triggers><DataTrigger Binding="{Binding IsPortraitOrSquare}" Value="True"><Setter Property="Stretch" Value="Uniform" /></DataTrigger></Style.Triggers></Style></Image.Style>
                            <Image.LayoutTransform><RotateTransform Angle="{Binding UserRotation}" /></Image.LayoutTransform>
                        </Image>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                            <CheckBox Style="{StaticResource CardCheckBox}" ToolTip="Selecionar esta foto" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" Margin="0,0,4,0"
                                      Visibility="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardPills}" />
                        </StackPanel>
                        <Border Style="{StaticResource StatusBadge}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"><TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="White" /></Border>
                        <Border Style="{StaticResource StatusBadge}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding DurationText, StringFormat=▶ {0}}" FontSize="10" Foreground="White" /></Border>
                        <Button Style="{StaticResource FavoriteToggleButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" ToolTip="Favorita"
                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <TextBlock Style="{StaticResource HeartGlyph}" />
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="2,7,2,0" FontWeight="Medium" Foreground="{DynamicResource HeadingBrush}" ToolTip="{Binding FileName}" />
                <DockPanel Grid.Row="2" Margin="2,4,2,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Dimensions}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <controls:RatingControl Value="{Binding Rating, Mode=OneWay}" IsReadOnly="True" StarSize="11" HorizontalAlignment="Left" />
                </DockPanel>
            </Grid>
        </DataTemplate>

        <ContextMenu x:Key="CollectionContextMenu">
            <MenuItem Header="Nova subcoleção…" Command="{Binding PlacementTarget.Tag.CreateSubcollectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Renomear…" Command="{Binding PlacementTarget.Tag.RenameCollectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" InputGestureText="F2">
                <MenuItem.Icon><TextBlock Text="&#xE8AC;" FontFamily="{StaticResource IconFont}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Mover para…" Command="{Binding PlacementTarget.Tag.MoveCollectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Text="&#xE8DE;" FontFamily="{StaticResource IconFont}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Expandir tudo" Command="{Binding PlacementTarget.Tag.ExpandAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" ToolTip="Expande esta coleção e todas as subcoleções" />
            <MenuItem Header="Recolher tudo" Command="{Binding PlacementTarget.Tag.CollapseAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" ToolTip="Recolhe esta coleção e todas as subcoleções" />
            <Separator />
            <MenuItem Header="Excluir…" Command="{Binding PlacementTarget.Tag.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" InputGestureText="Del">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource FavoriteBrush}" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <ContextMenu x:Key="FolderContextMenu">
            <MenuItem Header="Atualizar" Command="{Binding PlacementTarget.Tag.RefreshFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" ToolTip="Procura arquivos novos na pasta e marca como ausentes os que foram removidos">
                <MenuItem.Icon><TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Exibir no Explorer" Command="{Binding PlacementTarget.Tag.ShowFolderInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="12" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Expandir tudo" Command="{Binding PlacementTarget.Tag.ExpandAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" ToolTip="Expande esta pasta e todas as subpastas" />
            <MenuItem Header="Recolher tudo" Command="{Binding PlacementTarget.Tag.CollapseAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" ToolTip="Recolhe esta pasta e todas as subpastas" />
        </ContextMenu>
    </UserControl.Resources>
    <Grid>
    <Grid Visibility="{Binding IsBrowseMode, Converter={StaticResource BooleanToVisibilityConverter}}" AllowDrop="True" Background="Transparent"
          DragEnter="ExternalFiles_DragOver" DragOver="ExternalFiles_DragOver" DragLeave="ExternalFiles_DragLeave" Drop="ExternalFiles_Drop">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR ============ -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer x:Name="SidebarScrollViewer" VerticalScrollBarVisibility="Auto" Padding="10,6,10,16">
                <StackPanel>
                    <TextBlock Text="BIBLIOTECA" Style="{StaticResource SidebarHeader}" />
                    <ItemsControl ItemsSource="{Binding SmartLists}" ItemTemplate="{StaticResource SidebarEntryTemplate}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding RefreshFoldersCommand}" ToolTip="Atualizar: procura arquivos novos e marca como ausentes os removidos (pasta selecionada ou todas)" Width="24" Height="24" Padding="0" Margin="0,12,0,0">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <TextBlock Text="PASTAS" Style="{StaticResource SidebarHeader}" />
                    </DockPanel>
                    <TreeView x:Name="FolderTree" Style="{StaticResource FolderTreeView}" ItemsSource="{Binding Folders}" SelectedItemChanged="FolderTree_SelectedItemChanged"
                              AllowDrop="True" DragOver="FolderTree_DragOver" DragLeave="FolderTree_DragLeave" Drop="FolderTree_Drop">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type views:FolderNode}" ItemsSource="{Binding DisplayChildren}">
                                <DockPanel ToolTip="{Binding StateToolTip}" Background="Transparent" ContextMenu="{StaticResource FolderContextMenu}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsDragOver}" Value="True"><Setter Property="Background" Value="#332563EB" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" Width="22">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource IconText}"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsAccessible}" Value="False"><Setter Property="Text" Value="&#xE7BA;" /><Setter Property="Foreground" Value="#D97706" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0,2,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock Text="CATEGORIAS" Style="{StaticResource SidebarHeader}" />
                    <ItemsControl ItemsSource="{Binding CategoryEntries}" ItemTemplate="{StaticResource SidebarEntryTemplate}" />
                    <TextBlock Text="TAGS" Style="{StaticResource SidebarHeader}" />
                    <ItemsControl ItemsSource="{Binding TagEntries}" ItemTemplate="{StaticResource SidebarEntryTemplate}" />
                    <!-- Coleções inteligentes: buscas salvas que se atualizam sozinhas -->
                    <StackPanel Visibility="{Binding HasPro, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding SaveSmartCollectionCommand}" ToolTip="Salvar a busca atual como coleção inteligente" Width="24" Height="24" Padding="0" Margin="0,12,0,0">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <TextBlock Text="COLEÇÕES INTELIGENTES" Style="{StaticResource SidebarHeader}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SmartCollectionEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SidebarEntryTemplate}">
                                        <ContentPresenter.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Excluir coleção inteligente" Command="{Binding PlacementTarget.Tag.DeleteSmartCollectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </ContentPresenter.ContextMenu>
                                        <ContentPresenter.Tag><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" /></ContentPresenter.Tag>
                                    </ContentPresenter>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Digite uma busca (ex.: shorts:sim -uso:usado) e clique em + para guardá-la." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="10,0,4,0">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SmartCollectionEntries.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- Pessoas (IA local) -->
                    <StackPanel Visibility="{Binding HasPeople, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="PESSOAS" Style="{StaticResource SidebarHeader}" />
                        <ItemsControl ItemsSource="{Binding PeopleEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SidebarEntryTemplate}">
                                        <ContentPresenter.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Dar nome…" Command="{Binding PlacementTarget.Tag.RenamePersonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </ContentPresenter.ContextMenu>
                                        <ContentPresenter.Tag><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" /></ContentPresenter.Tag>
                                    </ContentPresenter>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border x:Name="CollectionRootDropTarget" Margin="0,16,0,4" CornerRadius="4" AllowDrop="True"
                            DragOver="CollectionRoot_DragOver" DragLeave="CollectionRoot_DragLeave" Drop="CollectionRoot_Drop">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDragOverRoot}" Value="True">
                                        <Setter Property="Background" Value="#332563EB" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CreateRootCollectionCommand}" ToolTip="Nova coleção" Width="24" Height="24" Padding="0">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <TextBlock Text="COLEÇÕES" Style="{StaticResource SidebarHeader}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding VirtualCollectionEntries}" ItemTemplate="{StaticResource SidebarEntryTemplate}" AllowDrop="True" DragOver="VirtualCollections_DragOver" Drop="VirtualCollections_Drop" />
                    <TreeView x:Name="CollectionTree" Style="{StaticResource FolderTreeView}" ItemsSource="{Binding CollectionNodes}"
                              SelectedItemChanged="CollectionTree_SelectedItemChanged" KeyDown="CollectionTree_KeyDown"
                              PreviewMouseLeftButtonDown="CollectionTree_PreviewMouseLeftButtonDown" PreviewMouseMove="CollectionTree_PreviewMouseMove"
                              AllowDrop="True" DragOver="CollectionTree_DragOver" DragLeave="CollectionTree_DragLeave" Drop="CollectionTree_Drop">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type views:CollectionNode}" ItemsSource="{Binding DisplayChildren}">
                                <DockPanel ToolTip="{Binding ToolTipText}" ContextMenu="{StaticResource CollectionContextMenu}" ContextMenuOpening="CollectionNode_ContextMenuOpening" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                                    <Setter Property="Background" Value="#332563EB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" Style="{StaticResource IconText}" Width="22" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DirectCount}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0,2,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers><DataTrigger Binding="{Binding IsAggregate}" Value="True"><Setter Property="FontStyle" Value="Italic" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ CENTRO: barra de ferramentas, filtros, grade, status ============ -->
        <Grid Grid.Column="1" Margin="16,14,16,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <!-- Barra superior: sem seleção = ferramentas de exibição; com seleção = ações sobre a seleção (barra contextual) -->
            <Grid Grid.Row="0" MinHeight="40">
                <DockPanel x:Name="ViewToolbar">
                    <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></DockPanel.Style>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{x:Static views:LibraryViewModel.SortChoices}" SelectedItem="{Binding SortOption}" Width="170" Margin="0,0,8,0" ToolTip="Ordenar" Visibility="{Binding HasPro, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Slider Minimum="110" Maximum="380" Value="{Binding RowHeight}" Width="90" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Tamanho das miniaturas"
                                Visibility="{Binding IsJustifiedGrid, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ToggleButton Style="{StaticResource ToolbarToggleButton}" IsChecked="{Binding IsJustifiedGrid, Mode=OneWay}" Command="{Binding ToggleGridCommand}" Padding="9,7" ToolTip="Grade justificada (proporção real) / grade uniforme"
                                      Visibility="{Binding HasPro, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xE80A;" Style="{StaticResource IconText}" /></ToggleButton>
                        <ToggleButton Style="{StaticResource ToolbarToggleButton}" IsChecked="{Binding IsMapMode}" Padding="9,7" ToolTip="Ver no mapa (itens com GPS)"
                                      Visibility="{Binding HasPro, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xE707;" Style="{StaticResource IconText}" /></ToggleButton>
                        <ToggleButton Style="{StaticResource ToolbarToggleButton}" IsChecked="{Binding ShowRightPanel}" Padding="9,7" ToolTip="Mostrar/ocultar o painel de detalhes"
                                      Visibility="{Binding HasPro, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xE89F;" Style="{StaticResource IconText}" /></ToggleButton>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenPaletteCommand}" Padding="9,7" Margin="0" ToolTip="Paleta de comandos: encontre qualquer ação, pasta ou coleção digitando (Ctrl+K)"
                                Visibility="{Binding HasPro, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource IconText}" Margin="0,0,6,0" /><TextBlock Text="Ctrl+K" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentButton}" Click="AddFolder_Click" Padding="14,8" Margin="0,0,12,0" ToolTip="Escolher uma pasta e indexar as fotos (inclui subpastas)">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource IconText}" Margin="0,0,8,0" /><TextBlock Text="Adicionar pasta" /></StackPanel>
                        </Button>
                        <ToggleButton Style="{StaticResource ToolbarToggleButton}" IsChecked="{Binding IsMultiSelectMode, Mode=TwoWay}" ToolTip="Multi-seleção: mostra as caixas de marcação e permite marcar/desmarcar clicando na própria foto">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE762;" Style="{StaticResource IconText}" Margin="0,0,8,0" /><TextBlock Text="Selecionar" /></StackPanel>
                        </ToggleButton>
                        <Button Style="{StaticResource ToolbarButton}" Click="SelectAll_Click" ToolTip="Seleciona todas as fotos visíveis (Ctrl+A)">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B3;" Style="{StaticResource IconText}" Margin="0,0,8,0" /><TextBlock Text="Selecionar tudo" /></StackPanel>
                        </Button>
                    </WrapPanel>
                </DockPanel>

                <!-- Barra contextual da seleção -->
                <Border x:Name="SelectionBar" Background="{DynamicResource SoftAccentBrush}" CornerRadius="10" Padding="6,4" Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <WrapPanel VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Click="ClearSelection_Click" ToolTip="Limpar seleção (Esc)" Margin="0,0,4,0"><TextBlock Text="&#xE711;" Style="{StaticResource IconText}" /></Button>
                        <TextBlock Text="{Binding SelectionBadgeText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,12,0" />
                        <Button Style="{StaticResource ToolbarButton}" Click="SelectAll_Click" Padding="9,6" ToolTip="Selecionar tudo (Ctrl+A)"><TextBlock Text="&#xE8B3;" Style="{StaticResource IconText}" /></Button>
                        <Button Style="{StaticResource ToolbarButton}" Click="OpenMenu_Click" Padding="9,6" ToolTip="Avaliação (teclas Ctrl+0 a Ctrl+5)">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE735;" Style="{StaticResource IconText}" Foreground="{DynamicResource StarBrush}" Margin="0,0,4,0" /><TextBlock Text="▾" FontSize="10" VerticalAlignment="Center" /></StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="★★★★★" Command="{Binding RateSelectionCommand}" CommandParameter="5" />
                                    <MenuItem Header="★★★★" Command="{Binding RateSelectionCommand}" CommandParameter="4" />
                                    <MenuItem Header="★★★" Command="{Binding RateSelectionCommand}" CommandParameter="3" />
                                    <MenuItem Header="★★" Command="{Binding RateSelectionCommand}" CommandParameter="2" />
                                    <MenuItem Header="★" Command="{Binding RateSelectionCommand}" CommandParameter="1" />
                                    <MenuItem Header="Sem estrelas" Command="{Binding RateSelectionCommand}" CommandParameter="0" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Click="OpenMenu_Click" Padding="9,6" ToolTip="Etiqueta de cor (teclas 1 a 6; 0 remove)">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Style="{StaticResource IconText}" Margin="0,0,4,0" /><TextBlock Text="▾" FontSize="10" VerticalAlignment="Center" /></StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu ItemsSource="{Binding SelectionColorChoices}">
                                    <ContextMenu.ItemContainerStyle><Style TargetType="MenuItem"><Setter Property="Command" Value="{Binding Command}" /><Setter Property="InputGestureText" Value="{Binding Shortcut}" /></Style></ContextMenu.ItemContainerStyle>
                                    <ContextMenu.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="{Binding Brush}" Stroke="#99888888" StrokeThickness="1" Margin="0,0,8,0" /><TextBlock Text="{Binding Name}" /></StackPanel></DataTemplate></ContextMenu.ItemTemplate>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasPro, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding PickCommand}" Padding="9,6" ToolTip="Escolher (P)"><TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="{DynamicResource SuccessBrush}" /></Button>
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding RejectCommand}" Padding="9,6" ToolTip="Rejeitar (X)"><TextBlock Text="&#xE711;" Style="{StaticResource IconText}" Foreground="{DynamicResource RejectBrush}" /></Button>
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding UnflagCommand}" Padding="9,6" ToolTip="Tirar bandeira (U)"><TextBlock Text="&#xE738;" Style="{StaticResource IconText}" /></Button>
                            <Button Style="{StaticResource ToolbarButton}" Click="OpenMenu_Click" Padding="9,6" ToolTip="Status de uso (projeto/publicação)">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FB;" Style="{StaticResource IconText}" Margin="0,0,4,0" /><TextBlock Text="Uso ▾" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Usado em…" Command="{Binding MarkUsedCommand}" />
                                        <MenuItem Header="Publicado" Command="{Binding MarkPublishedCommand}" />
                                        <MenuItem Header="Sem uso" Command="{Binding ClearUsageCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding CompareCommand}" Padding="9,6" ToolTip="Comparar lado a lado (2 a 4 itens)">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A9;" Style="{StaticResource IconText}" Margin="0,0,6,0" /><TextBlock Text="Comparar" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding ExportCommand}" Padding="9,6" ToolTip="Exportar com predefinição (tamanho, formato, marca d'água) (Ctrl+E)">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDE1;" Style="{StaticResource IconText}" Margin="0,0,6,0" /><TextBlock Text="Exportar" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding ExportCutsCommand}" Padding="9,6" ToolTip="Exportar os trechos marcados para o editor de vídeo (EDL / FCPXML)"><TextBlock Text="&#xE8C6;" Style="{StaticResource IconText}" /></Button>
                        </StackPanel>
                        <Button Style="{StaticResource ToolbarButton}" Click="MoveFiles_Click" Padding="9,6" ToolTip="Mover para outra pasta (o catálogo acompanha)"><TextBlock Text="&#xE8DE;" Style="{StaticResource IconText}" /></Button>
                        <Button Style="{StaticResource ToolbarButton}" Click="RecycleFiles_Click" Padding="9,6" ToolTip="Enviar para a Lixeira (Del)"><TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" Foreground="{DynamicResource FavoriteBrush}" /></Button>
                    </WrapPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,12,0,8">
            <WrapPanel>
                <Grid Width="430" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,34,7" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" LostKeyboardFocus="SearchBox_LostFocus"
                             ToolTip="Texto livre (nome, nota, local, tags) e filtros com chave:valor — ex.: tipo:video duração:&lt;60 orientação:vertical cor:verde nota:&gt;=3 -uso:usado. Digite uma chave para ver sugestões." />
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock Text="Buscar…  ex.: tipo:video duração:&lt;60 cor:verde" Foreground="{DynamicResource MutedBrush}" Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,3,0" Command="{Binding SemanticSearchCommand}" ToolTip="{Binding AiSearchToolTip}" ToolTipService.ShowOnDisabled="True"
                            Visibility="{Binding HasPro, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xE945;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentBrush}" /></Button>
                    <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="430">
                            <ListBox x:Name="SuggestionList" ItemsSource="{Binding SearchSuggestions}" BorderThickness="0" Background="Transparent" MaxHeight="260"
                                     PreviewMouseLeftButtonUp="SuggestionList_Click" PreviewKeyDown="SuggestionList_PreviewKeyDown" />
                        </Border>
                    </Popup>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"><TextBlock Text="Categoria" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" /><ComboBox ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding CategoryChoice}" MinWidth="110" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"><TextBlock Text="Tag" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" /><ComboBox ItemsSource="{Binding TagChoices}" SelectedItem="{Binding TagChoice}" MinWidth="100" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"><TextBlock Text="Coleção" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" /><ComboBox ItemsSource="{Binding CollectionChoices}" SelectedItem="{Binding CollectionChoice}" MinWidth="110" /></StackPanel>
                <CheckBox Content="Favoritas" IsChecked="{Binding FavoritesChoice}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ToggleButton Style="{StaticResource ToolbarToggleButton}" IsChecked="{Binding IsAdvancedOpen, Mode=TwoWay}" Content="{Binding AdvancedFiltersLabel}" Padding="10,5" Margin="0,0,10,0"
                              ToolTip="Mostra os filtros avançados: avaliação, orientação, tipo, extensão, cor e data" />
                <Button Content="Limpar filtros" Command="{Binding ClearFiltersCommand}" Padding="10,5" Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </WrapPanel>
            <TextBlock Text="{Binding QueryErrorText}" Foreground="{DynamicResource FavoriteBrush}" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap" Visibility="{Binding HasQueryError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <WrapPanel Margin="0,10,0,0" Visibility="{Binding IsAdvancedOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
                    <TextBlock Text="Avaliação" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox SelectedIndex="{Binding MinimumRatingChoice}" MinWidth="100"><ComboBoxItem Content="Qualquer" /><ComboBoxItem Content="1+ estrela" /><ComboBoxItem Content="2+ estrelas" /><ComboBoxItem Content="3+ estrelas" /><ComboBoxItem Content="4+ estrelas" /><ComboBoxItem Content="5 estrelas" /></ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,8"><TextBlock Text="Orientação" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" /><ComboBox ItemsSource="{x:Static views:LibraryViewModel.OrientationChoices}" SelectedItem="{Binding OrientationChoice}" MinWidth="100" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,8"><TextBlock Text="Tipo" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" /><ComboBox ItemsSource="{x:Static views:LibraryViewModel.TypeChoices}" SelectedItem="{Binding TypeChoice}" MinWidth="90" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,8"><TextBlock Text="Extensão" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" /><ComboBox ItemsSource="{Binding ExtensionChoices}" SelectedItem="{Binding ExtensionChoice}" MinWidth="90" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,8"><TextBlock Text="Cor" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" /><ComboBox ItemsSource="{x:Static views:LibraryViewModel.ColorFilterChoices}" SelectedItem="{Binding ColorFilterChoice}" MinWidth="100" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
                    <TextBlock Text="Data" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Data da captura (ou de criação do arquivo, se não houver)" />
                    <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}" Width="120" ToolTip="De" />
                    <TextBlock Text="até" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="6,0" />
                    <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}" Width="120" ToolTip="Até" />
                </StackPanel>
                <CheckBox Content="Agrupar por dia" IsChecked="{Binding GroupByDay}" VerticalAlignment="Center" Margin="0,0,12,8" Visibility="{Binding HasPro, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Cabeçalhos por dia na grade justificada (ordenação por data)" />
                <CheckBox Content="Empilhar RAW+JPEG e rajadas" IsChecked="{Binding StackPhotos}" VerticalAlignment="Center" Margin="0,0,10,8" Visibility="{Binding HasPro, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Mostra só a melhor foto de cada pilha, com um contador" />
            </WrapPanel>
            <!-- Fichas dos filtros ativos (cada uma com ✕) -->
            <ItemsControl ItemsSource="{Binding FilterChips}" Margin="0,8,0,0" Visibility="{Binding HasFilterChips, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SoftAccentBrush}" CornerRadius="12" Padding="10,3,4,3" Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource IconButton}" Command="{Binding RemoveCommand}" Width="18" Height="18" Padding="0" Margin="4,0,0,0" ToolTip="Remover este filtro">
                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="8" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ListBox x:Name="PhotoList" MouseDoubleClick="PhotoList_MouseDoubleClick" KeyDown="PhotoList_KeyDown"
                         PreviewMouseLeftButtonDown="PhotoList_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PhotoList_PreviewMouseLeftButtonUp" PreviewMouseMove="PhotoList_PreviewMouseMove"
                         ItemsSource="{Binding Photos}" SelectionMode="Extended" SelectedItem="{Binding SelectedPhoto}" SelectionChanged="PhotoList_SelectionChanged"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" Padding="0,0,0,4" Visibility="{Binding IsGridMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="ItemTemplate" Value="{StaticResource PhotoCardTemplate}" />
                            <Setter Property="ItemContainerStyle" Value="{StaticResource PhotoCardContainer}" />
                            <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="212" ItemHeight="214" /></ItemsPanelTemplate></Setter.Value></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsJustifiedGrid}" Value="True">
                                    <Setter Property="ItemTemplate" Value="{StaticResource JustifiedTileTemplate}" />
                                    <Setter Property="ItemContainerStyle" Value="{StaticResource JustifiedContainer}" />
                                    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><controls:VirtualizingJustifiedPanel RowHeight="{Binding RowHeight}" Spacing="6" HeaderBrush="{DynamicResource HeadingBrush}" /></ItemsPanelTemplate></Setter.Value></Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                </ListBox>

                <!-- Linha do tempo: anos e meses para saltar na grade (ordenação por data) -->
                <Border Grid.Column="1" Width="58" Margin="6,0,0,0">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasTimeline}" Value="True" /><Condition Binding="{Binding IsGridMode}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Border.Style>
                    <ItemsControl ItemsSource="{Binding Timeline}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.JumpToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding ToolTip}" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Right">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" /></Border></ControlTemplate></Button.Template>
                                    <TextBlock Text="{Binding Label}" FontSize="10" Margin="0,0,4,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsYear}" Value="True"><Setter Property="FontWeight" Value="Bold" /><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Mapa -->
                <Grid Visibility="{Binding IsMapMode, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.ColumnSpan="2">
                    <controls:MapView x:Name="Map" Items="{Binding MapPoints}" TileProvider="{Binding Tiles}" RegionCommand="{Binding MapRegionCommand}"
                                      Visibility="{Binding MapAllowed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border Background="{DynamicResource ScrimBrush}" CornerRadius="8" Padding="12,6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" IsHitTestVisible="False">
                        <TextBlock Text="{Binding MapSummary}" Foreground="White" FontSize="12" TextWrapping="Wrap" MaxWidth="520" />
                    </Border>
                    <TextBlock Text="Shift+arrastar desenha uma área para filtrar · roda do mouse aproxima · clique numa bolha para abrir" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,6" />
                    <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                        <Border.Visibility><Binding Path="MapAllowed" Converter="{x:Static views:InverseBooleanToVisibility.Instance}" /></Border.Visibility>
                        <StackPanel>
                            <TextBlock Text="Mapa online" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,12"
                                       Text="O mapa usa as imagens do OpenStreetMap (baixadas da internet e guardadas em cache). Só as coordenadas da área visível viajam; suas fotos nunca saem do computador." />
                            <Button Content="Permitir o mapa online" Style="{StaticResource AccentButton}" Command="{Binding AllowMapCommand}" HorizontalAlignment="Left" Padding="14,7" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Photos.Count}" Value="0" /><Condition Binding="{Binding IsGridMode}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="&#xE8B9;" Style="{StaticResource IconText}" FontSize="40" Foreground="{DynamicResource StarOffBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nenhuma foto para mostrar" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,2" HorizontalAlignment="Center" />
                    <TextBlock Text="Use “Adicionar pasta” para catalogar fotos ou ajuste os filtros." Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="90" Height="4" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ExportText}" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Value="{Binding ExportPercent, Mode=OneWay}" Width="110" Height="5" Margin="8,0" VerticalAlignment="Center" />
                        <Button Content="Cancelar" Command="{Binding CancelExportCommand}" Padding="8,2" FontSize="11" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding AnalysisStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontStyle="Italic" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ PAINEL DIREITO: depende da seleção (0 = vazio · 1 = preview e detalhes · 2+ = resumo da seleção) ============ -->
        <Border Grid.Column="2" Width="380" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Visibility="{Binding ShowRightPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <!-- Sem seleção: resumo do que está na tela (quantidade, horas de vídeo, espaço, triagem…) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                    <StackPanel Margin="20,18,20,20">
                        <TextBlock Text="{Binding ViewSummaryTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Resumo do que está na grade" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,14" />
                        <ItemsControl ItemsSource="{Binding ViewSummary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="{DynamicResource WindowBackground}" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                       Text="Selecione fotos (clique, Ctrl/Shift ou “Selecionar”) para ver detalhes e agir. Triagem rápida: P escolhe, X rejeita, U desmarca; 1–6 marcam cor; Ctrl+K encontra qualquer ação." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Margin="16,14,16,0" Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                    <!-- Cabeçalho: 1 foto = preview; 2+ = resumo com miniaturas -->
                    <Grid Grid.Row="0">
                        <Grid Visibility="{Binding IsSingleSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Grid.Row="0" Height="210" Background="#0F172A" CornerRadius="8" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding SelectedPhoto.ThumbnailUri}" Stretch="Uniform" />
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <controls:VideoPlayer x:Name="PreviewPlayer" IsCompact="True" RotationDegrees="{Binding SelectedVideoRotation}" SourcePath="{Binding SelectedVideoPath}" Visibility="{Binding IsSelectedVideo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="Arquivo ausente" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPhoto.IsMissing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <Button Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0" Background="#66000000" Foreground="White" ToolTip="Foto anterior"><TextBlock Text="&#xE76B;" Style="{StaticResource IconText}" /></Button>
                                    <Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0" Background="#66000000" Foreground="White" ToolTip="Próxima foto"><TextBlock Text="&#xE76C;" Style="{StaticResource IconText}" /></Button>
                                    <Border Style="{StaticResource PreviewOverlayBadge}" HorizontalAlignment="Right" Margin="8"><TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="White" /></Border>
                                    <Button AutomationProperties.Name="Revisar" Style="{StaticResource PreviewOverlayButton}" Command="{Binding EnterReviewCommand}" HorizontalAlignment="Left" Margin="8" Background="#B3111A2B" ToolTip="Abrir em tela de revisão (duplo clique ou Enter na grade)"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE740;" Style="{StaticResource IconText}" Margin="0,0,6,0" /><TextBlock Text="Revisar" FontSize="12" VerticalAlignment="Center" /></StackPanel></Button>
                                </Grid>
                            </Border>
                            <DockPanel Grid.Row="1" Margin="0,12,0,10">
                                <controls:RatingControl DockPanel.Dock="Right" Value="{Binding SelectedPhoto.Rating, Mode=TwoWay}" StarSize="16" VerticalAlignment="Center" ToolTip="Avaliação (clique novamente para limpar; salve em Organização)" />
                                <TextBlock Text="{Binding SelectedPhoto.FileName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding SelectedPhoto.FileName}" />
                            </DockPanel>
                        </Grid>

                        <Border Visibility="{Binding IsMultiSelection, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource SoftAccentBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectionTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding SelectionDetails}" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,3,0,10" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding SelectionThumbnails}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><Border Width="48" Height="36" Margin="0,0,6,6" Background="#C9D6F2" CornerRadius="4" ClipToBounds="True"><Image Source="{Binding ThumbnailUri}" Stretch="UniformToFill" /></Border></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap">
                                    <TextBlock.Text><MultiBinding StringFormat="Mostrando {0} de {1}. Desmarque na grade para tirar fotos da seleção."><Binding Path="SelectionThumbnails.Count" /><Binding Path="SelectionCount" /></MultiBinding></TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TabControl Grid.Row="1" Style="{StaticResource UnderlineTabControl}">
                        <!-- Aba: Informações -->
                        <TabItem Header="Informações">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid Margin="0,0,6,12" Visibility="{Binding IsSingleSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.Resources><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="TextWrapping" Value="Wrap" /></Style></Grid.Resources>
                                        <TextBlock Grid.Row="0" Text="Nome" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPhoto.FileName}" />
                                        <TextBlock Grid.Row="1" Text="Pasta" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPhoto.FolderPath}" FontSize="12" />
                                        <TextBlock Grid.Row="2" Text="Tamanho" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPhoto.SizeText}" />
                                        <TextBlock Grid.Row="3" Text="Dimensões" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPhoto.Dimensions}" />
                                        <TextBlock Grid.Row="4" Text="Criado em" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedPhoto.CreatedText}" />
                                        <TextBlock Grid.Row="5" Text="Modificado" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedPhoto.ModifiedText}" />
                                        <TextBlock Grid.Row="6" Text="Tipo" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedPhoto.StatusText}" />
                                        <TextBlock Grid.Row="7" Text="Orientação" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedPhoto.OrientationText}" />
                                        <TextBlock Grid.Row="8" Text="Cor" Foreground="{DynamicResource MutedBrush}" /><StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8"><Ellipse Width="12" Height="12" Fill="{Binding SelectedPhoto.ColorBrush}" Stroke="#99888888" StrokeThickness="1" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="{Binding SelectedPhoto.ColorName}" Margin="0" /></StackPanel>
                                        <TextBlock Grid.Row="9" Text="Local" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedPhoto.PlaceText}" />
                                        <TextBlock Grid.Row="10" Text="GPS" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedPhoto.CoordinatesText}" FontSize="12" />
                                        <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="Obter localização" Command="{Binding FindLocationCommand}" CommandParameter="{Binding SelectedPhoto}" Padding="8,3" FontSize="12" Margin="0,0,8,0" ToolTip="Lê o GPS gravado no arquivo e descobre o nome do lugar (OpenStreetMap/Nominatim, só com sua autorização)." />
                                            <Button Content="Ver no mapa" Command="{Binding OpenMapCommand}" CommandParameter="{Binding SelectedPhoto}" Padding="8,3" FontSize="12" ToolTip="Abre o local no OpenStreetMap">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPhoto.HasGps}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Margin="0,0,6,12" Visibility="{Binding IsMultiSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Várias fotos selecionadas" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                                        <TextBlock Text="Os detalhes individuais aparecem quando há uma só foto selecionada. Para agir sobre o grupo, use as abas:" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"><Run FontWeight="SemiBold" Text="Organização" /><Run Text=" — categoria, tags, coleções, avaliação, favorito e nota." /></TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"><Run FontWeight="SemiBold" Text="Arquivos" /><Run Text=" — mover, copiar, renomear e excluir." /></TextBlock>
                                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Metadados" /><Run Text=" — título, descrição, palavras-chave, autor e copyright." /></TextBlock>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Aba: Organização -->
                        <TabItem Header="Organização">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <!-- 1 foto: edita e salva -->
                                    <StackPanel Margin="0,0,6,12" Visibility="{Binding IsSingleSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Organização da foto" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                                        <TextBlock Text="Categoria, tags e coleções são só do catálogo; o arquivo não é alterado." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="Categoria" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SelectedPhoto.Category, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Tags (separadas por vírgula)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SelectedPhoto.TagsText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Coleções" Style="{StaticResource FieldLabel}" />
                                        <ItemsControl ItemsSource="{Binding SelectedPhotoCollections}" Margin="0,0,0,4">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SoftAccentBrush}" CornerRadius="12" Padding="8,4" Margin="0,0,6,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                            <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.RemovePhotoFromCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Remover da coleção" Padding="2" Width="16" Height="16">
                                                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="(Nenhuma coleção)" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedPhotoCollections.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <DockPanel Margin="0,0,0,10">
                                            <ComboBox ItemsSource="{Binding AvailableCollectionsForSelectedPhoto}" SelectedItem="{Binding SelectedCollectionToAdd, Mode=TwoWay}" DisplayMemberPath="Path" MinWidth="180" ToolTip="Adicionar à coleção ▾" />
                                        </DockPanel>
                                        <TextBlock Text="Nota pessoal" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SelectedPhoto.PersonalNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="76" VerticalContentAlignment="Top" />
                                        <CheckBox Content="Favorita" IsChecked="{Binding SelectedPhoto.IsFavorite}" Margin="0,12,0,0" />
                                        <Button Content="Salvar organização" Style="{StaticResource AccentButton}" Click="SaveOrganization_Click" Margin="0,14,0,0" />
                                    </StackPanel>

                                    <!-- 2+ fotos: lote; campo vazio / "Manter" não altera nada -->
                                    <StackPanel Margin="0,0,6,12" Visibility="{Binding IsMultiSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Organizar as fotos selecionadas" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                                        <TextBlock Text="{Binding TargetText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,2,0,0" />
                                        <TextBlock Text="Campos vazios ou “Manter” não alteram nada. Tags e coleções são acrescentadas às que cada foto já tem." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="Categoria" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding BatchCategory, UpdateSourceTrigger=PropertyChanged}" ToolTip="Substitui a categoria das fotos" />
                                        <TextBlock Text="Adicionar tags (separadas por vírgula)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding BatchTagsText, UpdateSourceTrigger=PropertyChanged}" />
                                        <!-- Coleções em comum: aparece só quando TODAS as fotos selecionadas têm exatamente as mesmas coleções -->
                                        <StackPanel Visibility="{Binding HasCommonCollections, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Remover todas" Command="{Binding RemoveAllCommonCollectionsCommand}" Padding="8,2" FontSize="11" ToolTip="Tira todas estas coleções de todas as fotos selecionadas (os arquivos não são afetados)" />
                                                <TextBlock Text="Coleções das fotos selecionadas" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding CommonCollections}" Margin="0,2,0,0">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SoftAccentBrush}" CornerRadius="12" Padding="8,4" Margin="0,0,6,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.RemoveCommonCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Remover esta coleção de todas as fotos selecionadas" Padding="2" Width="16" Height="16">
                                                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <TextBlock Text="Adicionar às coleções" Style="{StaticResource FieldLabel}" />
                                        <ItemsControl ItemsSource="{Binding BatchSelectedCollections}" Margin="0,0,0,4">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SoftAccentBrush}" CornerRadius="12" Padding="8,4" Margin="0,0,6,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                            <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.RemoveBatchCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Remover do lote" Padding="2" Width="16" Height="16">
                                                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <DockPanel Margin="0,0,0,10">
                                            <ComboBox ItemsSource="{Binding AvailableCollectionsForBatch}" SelectedItem="{Binding SelectedBatchCollectionToAdd, Mode=TwoWay}" DisplayMemberPath="Path" MinWidth="180" ToolTip="Escolha coleções para adicionar às fotos selecionadas" />
                                        </DockPanel>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Avaliação" Style="{StaticResource FieldLabel}" />
                                                <ComboBox SelectedIndex="{Binding BatchRatingIndex}"><ComboBoxItem Content="Manter" /><ComboBoxItem Content="Sem estrelas" /><ComboBoxItem Content="1 estrela" /><ComboBoxItem Content="2 estrelas" /><ComboBoxItem Content="3 estrelas" /><ComboBoxItem Content="4 estrelas" /><ComboBoxItem Content="5 estrelas" /></ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Favorito" Style="{StaticResource FieldLabel}" />
                                                <ComboBox SelectedIndex="{Binding BatchFavoriteIndex}"><ComboBoxItem Content="Manter" /><ComboBoxItem Content="Marcar" /><ComboBoxItem Content="Desmarcar" /></ComboBox>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Nota (substitui a nota das fotos)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding BatchNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="56" VerticalContentAlignment="Top" />
                                        <Border Background="{DynamicResource WindowBackground}" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                                            <TextBlock Text="{Binding OrganizationImpactText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                        </Border>
                                        <Button Command="{Binding ApplyOrganizationBatchCommand}" Style="{StaticResource AccentButton}" Margin="0,10,0,0" Padding="12,9">
                                            <TextBlock Text="{Binding SelectionCount, StringFormat=Aplicar a {0} fotos}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Aba: Cortes (só vídeo): marcar entrada/saída na posição do player e guardar trechos para o editor -->
                        <TabItem Header="Cortes">
                            <TabItem.Style><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSelectedVideo}" Value="True" /><Condition Binding="{Binding IsSingleSelection}" Value="True" /><Condition Binding="{Binding HasPro}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></TabItem.Style>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,6,12">
                                    <TextBlock Text="Trechos do vídeo" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                                    <TextBlock Text="Toque o vídeo acima, marque a entrada e a saída na posição atual e dê um nome. Depois, “Exportar cortes” gera a lista para o DaVinci/Premiere." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button Click="MarkIn_Click" ToolTip="Entrada na posição atual do player (tecla I na revisão)"><StackPanel Orientation="Horizontal"><TextBlock Text="[" FontWeight="Bold" Margin="0,0,6,0" /><TextBlock Text="Entrada" /></StackPanel></Button>
                                        <Button Grid.Column="2" Click="MarkOut_Click" ToolTip="Saída na posição atual do player (tecla O na revisão)"><StackPanel Orientation="Horizontal"><TextBlock Text="Saída" /><TextBlock Text="]" FontWeight="Bold" Margin="6,0,0,0" /></StackPanel></Button>
                                    </Grid>
                                    <TextBlock Text="{Binding MarkerRangeText}" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" />
                                    <TextBlock Text="Nome do trecho (opcional)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding MarkerName, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Guardar trecho" Style="{StaticResource AccentButton}" Command="{Binding AddMarkerCommand}" Margin="0,10,0,0" />
                                    <TextBlock Text="TRECHOS MARCADOS" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
                                    <ItemsControl ItemsSource="{Binding Markers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource WindowBackground}" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding DataContext.DeleteMarkerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Apagar trecho">
                                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                                                        </Button>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="PlayMarker_Click" Tag="{Binding}" ToolTip="Ir para a entrada">
                                                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                                                        </Button>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding RangeText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Exportar cortes (EDL / FCPXML)…" Command="{Binding ExportCutsCommand}" Margin="0,8,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Aba: Arquivos -->
                        <TabItem Header="Arquivos">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,6,12" IsEnabled="{Binding HasSelection}">
                                    <TextBlock Text="Operações nos arquivos" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                                    <TextBlock Text="{Binding TargetText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,2,0,0" />
                                    <TextBlock Text="Estas ações mexem nos arquivos no disco (o catálogo acompanha)." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />

                                    <TextBlock Text="MOVER E COPIAR" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Click="MoveFiles_Click" ToolTip="Mover os arquivos para outra pasta (o catálogo mantém a identidade e a organização)">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8DE;" Style="{StaticResource IconText}" Margin="0,0,8,0" /><TextBlock Text="Mover para…" /></StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Click="CopyFiles_Click" ToolTip="Copiar os arquivos para outra pasta">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" Margin="0,0,8,0" /><TextBlock Text="Copiar para…" /></StackPanel>
                                        </Button>
                                    </Grid>
                                    <CheckBox x:Name="AddCopyToCatalogBox" Content="Adicionar as cópias ao catálogo" Margin="0,8,0,0" />

                                    <TextBlock Text="RENOMEAR" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
                                    <TextBox x:Name="RenameTemplateBox" ToolTip="1 foto: novo nome. Várias: template, ex.: {date}_{name} ou {year}-{month}-{sequence}" />
                                    <TextBlock Text="1 foto: digite o novo nome. Várias: use um template. Variáveis: {name} {date} {year} {month} {sequence}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <Button Content="Renomear" Click="Rename_Click" Margin="0,8,0,0" />

                                    <TextBlock Text="EXCLUIR" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
                                    <Button Style="{StaticResource DangerButton}" Click="RecycleFiles_Click" ToolTip="Envia os arquivos para a Lixeira do Windows">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" Margin="0,0,8,0" /><TextBlock Text="Enviar para a Lixeira…" /></StackPanel>
                                    </Button>
                                    <TextBlock Text="Pede confirmação. Os arquivos vão para a Lixeira do Windows e podem ser restaurados por lá." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Aba: Metadados -->
                        <TabItem Header="Metadados">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,6,12" IsEnabled="{Binding HasSelection}">
                                    <TextBlock Text="Metadados dos arquivos (IPTC/XMP)" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                                    <TextBlock Text="{Binding TargetText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,2,0,0" />
                                    <Border Background="{DynamicResource WindowBackground}" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock FontSize="13">
                                                <TextBlock.Text><MultiBinding StringFormat="{}{0} de {1} foto(s) são JPEG e podem ser gravadas."><Binding Path="EditableSelectionCount" /><Binding Path="SelectionCount" /></MultiBinding></TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="PNG, WEBP, RAW e arquivos ausentes são ignorados. EXIF e imagem nunca são alterados." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="OPERAÇÕES POR CAMPO NO EDITOR" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run FontWeight="SemiBold" Text="Título" /><Run Text=" — manter ou substituir" /></TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run FontWeight="SemiBold" Text="Descrição" /><Run Text=" — manter, substituir ou acrescentar" /></TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run FontWeight="SemiBold" Text="Palavras-chave" /><Run Text=" — manter, substituir, adicionar, remover ou limpar" /></TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run FontWeight="SemiBold" Text="Autor e Copyright" /><Run Text=" — manter ou substituir" /></TextBlock>
                                    <TextBlock Text="O editor mostra cada foto em uma linha (edição rápida) e aplica operações em lote nos rascunhos: você vê o resultado antes de gravar." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <Button AutomationProperties.Name="Abrir editor de metadados" Click="BatchMetadata_Click" Style="{StaticResource AccentButton}" Margin="0,14,0,0" Padding="12,9">
                                        <TextBlock Text="{Binding SelectionCount, StringFormat=Abrir editor com {0} foto(s)…}" />
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Border>
        <!-- Paleta de comandos (Ctrl+K): digite para achar qualquer ação, pasta, coleção ou área -->
        <Grid Grid.ColumnSpan="3" Background="#66000000" Visibility="{Binding IsPaletteOpen, Converter={StaticResource BooleanToVisibilityConverter}}" MouseDown="PaletteBackdrop_MouseDown">
            <Border Width="620" VerticalAlignment="Top" Margin="0,70,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" MouseDown="PalettePanel_MouseDown">
                <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" /></Border.Effect>
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="PaletteBox" Text="{Binding PaletteText, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="32,8,8,8" PreviewKeyDown="PaletteBox_PreviewKeyDown" IsVisibleChanged="PaletteBox_IsVisibleChanged" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    </Grid>
                    <ListBox x:Name="PaletteList" ItemsSource="{Binding PaletteResults}" MaxHeight="420" Margin="0,8,0,0" BorderThickness="0" Background="Transparent" MouseUp="PaletteList_MouseUp" PreviewKeyDown="PaletteList_PreviewKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,3">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedBrush}" Width="26" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource HeadingBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Group}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Enter executa · ↑↓ navegam · Esc fecha" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="4,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>
        <!-- Aviso enquanto arquivos do Explorer são arrastados sobre a biblioteca -->
        <Border Grid.ColumnSpan="3" Margin="8" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="12" Background="#1A2563EB" IsHitTestVisible="False"
                Visibility="{Binding IsExternalDragOver, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ExternalDragText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
    <!-- Modo de revisão: substitui a grade enquanto ativo (o DataContext da revisão é a ReviewViewModel) -->
    <Grid Visibility="{Binding IsReviewMode, Converter={StaticResource BooleanToVisibilityConverter}}">
        <views:ReviewView DataContext="{Binding Review}" />
    </Grid>

    <!-- Popup flutuante de feedback de drag-and-drop -->
    <Popup x:Name="DragFeedbackPopup" IsOpen="False" AllowsTransparency="True" Placement="Absolute" Focusable="False" IsHitTestVisible="False">
        <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="8,4" SnapsToDevicePixels="True">
            <TextBlock x:Name="DragFeedbackText" Foreground="White" FontSize="12" FontWeight="Medium" />
        </Border>
    </Popup>
    </Grid>
</UserControl>
