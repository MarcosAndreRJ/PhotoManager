<Window x:Class="PhotoManager.Wpf.Views.DeleteCollectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PhotoManager.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DeleteCollectionViewModel}"
        Title="Excluir coleção"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}">
    <Border Padding="22">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <Border Width="36" Height="36" Background="{DynamicResource DangerSoftBrush}" CornerRadius="18" Margin="0,0,12,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource FavoriteBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Excluir coleção" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                    <TextBlock Text="{Binding CollectionName, StringFormat=«{0}»}" FontSize="13" Foreground="{DynamicResource MutedBrush}" FontWeight="Medium" />
                </StackPanel>
            </DockPanel>

            <!-- Caso 1: Sem subcoleções -->
            <StackPanel Visibility="{Binding HasNoSubcollections, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding SingleCollectionMessage}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{DynamicResource TextBrush}"
                           LineHeight="18"
                           Margin="0,0,0,16" />
            </StackPanel>

            <!-- Caso 2: Com subcoleções -->
            <StackPanel Visibility="{Binding HasSubcollections, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding HeaderSummary}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,12" />

                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <RadioButton IsChecked="{Binding IsPromoteSelected}" Margin="0,0,0,10">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Excluir somente esta e mover subcoleções para o nível acima" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="As subcoleções são promovidas para o nível do pai desta coleção." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton IsChecked="{Binding IsWithDescendantsSelected}">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Excluir esta e todas as suas subcoleções" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Exclui a coleção e suas subcoleções em cascata no catálogo." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Aviso inegociável de segurança -->
            <Border Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Nenhum arquivo físico será excluído." FontWeight="SemiBold" Foreground="#92400E" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Botões de ação -->
            <DockPanel LastChildFill="False">
                <Button Content="Cancelar"
                        IsCancel="True"
                        DockPanel.Dock="Right"
                        Width="90"
                        Margin="10,0,0,0" />
                <Button Content="Excluir"
                        Style="{StaticResource DangerButton}"
                        IsDefault="True"
                        DockPanel.Dock="Right"
                        Width="100"
                        Click="ConfirmButton_Click" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
