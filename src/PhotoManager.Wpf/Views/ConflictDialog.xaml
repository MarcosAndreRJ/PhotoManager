<Window x:Class="PhotoManager.Wpf.Views.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Itens com o mesmo nome" Width="500" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}">
    <Border Padding="20">
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock x:Name="Detail" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <Button x:Name="KeepBothButton" Click="KeepBoth_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6">
                <StackPanel><TextBlock Text="Manter os dois" FontWeight="SemiBold" /><TextBlock Text="O novo ganha um número: foto (2).jpg" Foreground="{DynamicResource MutedBrush}" FontSize="12" /></StackPanel>
            </Button>
            <Button Click="Skip_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6">
                <StackPanel><TextBlock Text="Ignorar estes itens" FontWeight="SemiBold" /><TextBlock Text="O que já está no destino fica como está" Foreground="{DynamicResource MutedBrush}" FontSize="12" /></StackPanel>
            </Button>
            <Button Click="Replace_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,16">
                <StackPanel><TextBlock Text="Substituir" FontWeight="SemiBold" /><TextBlock Text="O item antigo do destino vai para a Lixeira" Foreground="{DynamicResource MutedBrush}" FontSize="12" /></StackPanel>
            </Button>
            <TextBlock Text="Pastas com o mesmo nome são mescladas; a escolha vale para os arquivos de dentro." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Button Content="Cancelar" IsCancel="True" HorizontalAlignment="Right" Width="100" />
        </StackPanel>
    </Border>
</Window>
