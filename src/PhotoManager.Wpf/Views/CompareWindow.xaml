<Window x:Class="PhotoManager.Wpf.Views.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PhotoManager.Wpf.Controls"
        Title="Comparar" Width="1400" Height="900" WindowStartupLocation="CenterOwner" Background="#0B0F15" KeyDown="Window_KeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#151B24" Padding="16,10">
            <TextBlock Foreground="#AAB4C3" FontSize="12" Text="P escolhe · X rejeita · Ficar com este = escolhe e rejeita os outros · Esc fecha. As decisões vão para o catálogo (filtro “Escolhidas”/“Rejeitadas”)." />
        </Border>
        <ItemsControl ItemsSource="{Binding Items}" Margin="8">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="6" CornerRadius="8" Background="#111720" BorderThickness="3" Focusable="True" MouseDown="Item_MouseDown">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Card.IsPicked}" Value="True"><Setter Property="BorderBrush" Value="#22C55E" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Card.IsRejected}" Value="True"><Setter Property="BorderBrush" Value="#EF4444" /><Setter Property="Opacity" Value="0.55" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="10,8">
                                <TextBlock Text="{Binding Caption}" Foreground="#DDE3EC" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <controls:RatingControl Value="{Binding Card.Rating, Mode=OneWay}" IsReadOnly="True" StarSize="14" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <Button Content="Escolher (P)" Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,4" Margin="0,0,6,0" />
                                    <Button Content="Rejeitar (X)" Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,4" Margin="0,0,6,0" />
                                    <Button Content="Ficar com este" Style="{StaticResource AccentButton}" Command="{Binding DataContext.KeepOnlyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,4" />
                                </StackPanel>
                            </StackPanel>
                            <Grid>
                                <Image Source="{Binding Card.ThumbnailUri}" Stretch="Uniform" />
                                <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
