<Window x:Class="PhotoManager.Wpf.Views.BatchRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="620" Height="540" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" Margin="0,0,0,12" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Modelo do nome (a extensão é mantida)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="TemplateBox" Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Começar em" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Help}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10" />
        <ListView Grid.Row="3" ItemsSource="{Binding Preview}" BorderBrush="{DynamicResource BorderBrush}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nome atual" Width="260" DisplayMemberBinding="{Binding Before}" />
                    <GridViewColumn Header="Novo nome" Width="280" DisplayMemberBinding="{Binding After}" />
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock Grid.Row="4" Text="{Binding Error}" Foreground="{DynamicResource FavoriteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
        <DockPanel Grid.Row="5" LastChildFill="False" Margin="0,12,0,0">
            <Button Content="Cancelar" IsCancel="True" DockPanel.Dock="Right" Width="100" Margin="10,0,0,0" />
            <Button Content="Renomear" Style="{StaticResource AccentButton}" IsDefault="True" IsEnabled="{Binding IsValid}" DockPanel.Dock="Right" Width="110" Click="Confirm_Click" />
            <TextBlock DockPanel.Dock="Left" Text="Ctrl+Z desfaz depois." Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
