<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Superfícies -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F5F7FA" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#F0F3F8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E1E6EE" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E8EDF6" />

    <!-- Texto -->
    <SolidColorBrush x:Key="HeadingBrush" Color="#172033" />
    <SolidColorBrush x:Key="TextBrush" Color="#334155" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7A90" />

    <!-- Destaque -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="SoftAccentBrush" Color="#E6EEFF" />
    <SolidColorBrush x:Key="StarBrush" Color="#F5B301" />
    <SolidColorBrush x:Key="StarOffBrush" Color="#CBD3DF" />
    <SolidColorBrush x:Key="FavoriteBrush" Color="#E5484D" />

    <!-- Barra de navegação superior (escura) -->
    <SolidColorBrush x:Key="NavBarBrush" Color="#111A2B" />
    <SolidColorBrush x:Key="NavTextBrush" Color="#C6D0E0" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#1C2A44" />

    <!-- Cartões de foto: etiqueta de cor = fundo suave + borda discreta; seleção = borda azul (estados independentes) -->
    <SolidColorBrush x:Key="PhotoCardDefaultBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PhotoCardDefaultBorder" Color="#E1E6EE" />
    <SolidColorBrush x:Key="PhotoCardSelectedBorder" Color="#2563EB" />
    <SolidColorBrush x:Key="PhotoCardSelectedBackground" Color="#E6EEFF" />
    <SolidColorBrush x:Key="PhotoCardHoverBorder" Color="#9DB8F5" />
    <SolidColorBrush x:Key="PhotoCardHoverOverlay" Color="#12000000" />
    <SolidColorBrush x:Key="PhotoLabelRedBackground" Color="#1FEF4444" />
    <SolidColorBrush x:Key="PhotoLabelRedBorder" Color="#B3EF4444" />
    <SolidColorBrush x:Key="PhotoLabelOrangeBackground" Color="#1FF97316" />
    <SolidColorBrush x:Key="PhotoLabelOrangeBorder" Color="#B3F97316" />
    <SolidColorBrush x:Key="PhotoLabelYellowBackground" Color="#26EAB308" />
    <SolidColorBrush x:Key="PhotoLabelYellowBorder" Color="#B3EAB308" />
    <SolidColorBrush x:Key="PhotoLabelGreenBackground" Color="#1F22C55E" />
    <SolidColorBrush x:Key="PhotoLabelGreenBorder" Color="#B322C55E" />
    <SolidColorBrush x:Key="PhotoLabelBlueBackground" Color="#1F3B82F6" />
    <SolidColorBrush x:Key="PhotoLabelBlueBorder" Color="#B33B82F6" />
    <SolidColorBrush x:Key="PhotoLabelPurpleBackground" Color="#1FA855F7" />
    <SolidColorBrush x:Key="PhotoLabelPurpleBorder" Color="#B3A855F7" />

    <!-- Áreas neutras e avisos -->
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#E4E9F1" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FDE68A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="RejectBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />
</ResourceDictionary>
